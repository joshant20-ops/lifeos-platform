{
  "schema_version": 1,
  "default": "normal",
  "domains": {
    "personal-administration": {
      "privacy": "local-only",
      "cloud_fallback": false,
      "sources": ["calendar", "email", "paperless", "personal-documents"],
      "request_terms": [
        "personal administration",
        "my calendar",
        "my appointments",
        "my email",
        "my emails",
        "my inbox",
        "my documents",
        "paperless"
      ],
      "public_reference_queries": "sanitized-general-question-only"
    },
    "finance-assets": {
      "privacy": "local-only",
      "cloud_fallback": false,
      "sources": ["transactions", "balances", "banking", "rental", "receipts", "invoices", "tax-records", "vehicle-costs", "mileage"],
      "request_terms": [
        "finance assets",
        "personal finance",
        "rental finance",
        "my transactions",
        "my balances",
        "my banking",
        "my rental",
        "my receipts",
        "my invoices",
        "my tax records",
        "my vehicle costs",
        "my mileage"
      ],
      "public_reference_queries": "sanitized-general-question-only"
    }
  },
  "fail_closed": true,
  "rules": [
    "Private source content never enters a cloud prompt.",
    "Failure or incapacity of local AI never triggers automatic cloud fallback.",
    "A public-reference subquery must be separated from private context before cloud/web use.",
    "Authoritative records and calculations remain in deterministic local or selected OTS systems."
  ]
}
