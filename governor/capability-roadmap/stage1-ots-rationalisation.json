{
  "schema_version": 1,
  "capability_stage": 1,
  "name": "OTS rationalisation and custom-code purge",
  "principle": "OTS first; configuration and integration before bespoke code",
  "classification": ["KEEP_OTS", "KEEP_THIN_GLUE", "REPLACE_WITH_OTS", "RETIRE_OBSOLETE", "REVIEW_UNIQUE"],
  "protected": [
    "Watchman execution authority",
    "GitHub canonical source",
    "Stage 10/11/12 governance gates",
