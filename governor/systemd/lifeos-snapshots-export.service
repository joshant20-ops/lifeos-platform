[Unit]
Description=Export sanitised LifeOS observed state to lifeos-snapshots
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=joshan
Group=joshan
Environment=HOME=/home/joshan
Environment=LIFEOS_PLATFORM_REPO=/home/joshan/lifeos-platform
Environment=LIFEOS_SNAPSHOTS_REPO=/home/joshan/lifeos-snapshots
Environment=LIFEOS_HOST_ROLE=pi5-controller
ExecStart=/home/joshan/lifeos-platform/governor/scripts/snapshot-lifeos-observed-state.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/joshan/lifeos-snapshots
ReadOnlyPaths=/home/joshan/lifeos-platform
TimeoutStartSec=3min
