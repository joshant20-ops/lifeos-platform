#!/usr/bin/env pytho
Process the next ten autonomous-safe unresolved LifeOS ledger issues after the current batch: GitHub issues #412, #415, #416, #417, #418, #419, #421, #423, #424 and #425.

For each issue, independently inspect current canonical main, current architecture, historical records and all available live runtime evidence. Use simulations/unit/integration tests where they materially reduce uncertainty, then perform any safe engineering needed through the existing governed LifeOS execution paths. Do not infer completion from age, a historical merge, or broad system health.

Issue-specific acceptance is mandatory. For each item, obtain current live evidence that proves COMPLETE, OBSOLETE/SUPERSEDED, or DUPLICATE before closing it. Archive a sanitised disposition/evidence record in lifeos-jobs before closure. If an issue needs credentials, physical intervention, an irreversible/high-risk action, or a user policy decision, leave it open and record the exact external blocker; do not substitute another issue merely to reach ten closures.

Preserve current invariants: Pi5 is orchestration/control only; private/personal data stays local; Tower Ollama is the local/private AI path and should be demand-powered through the existing lease/WoL lifecycle; normal sanitized engineering may use the governed engineering route; no direct production SSH mutation outside the existing governed runtime controls; no sudo assumption; canonical Git changes use branch/PR publication; do not revive retired architecture merely to satisfy a historical requirement.

For issue #412 specifically, distinguish the current governed OpenHands/local-builder role from obsolete historical OpenHands architecture and prove whether any Engineer VM cleanup remains necessary before disposition. For #415 prove snapshot/FIFO publishing behavior under current implementation. For #416 and #417 live-prove job history, queue/stuck detection and observability contracts. For #418 prove the current issue-to-Engineer/Governor pickup path or its documented successor. For #419 reproduce/simulate dirty-checkout handling and prove the old OTS-migration blocker cannot recur in the current canonical path. For #421 live-prove private-document local-only routing plus Tower wake/lease/release lifecycle without exposing private content. For #423-#425 evaluate historical Semaphore/Ansible/planner/root-control designs against the current governed transactional architecture, implement only demonstrated missing requirements, and live-prove the retained requirement or archive it as superseded.

Final result must enumerate all ten issues with disposition, tests/simulations run, live evidence reference, GitHub closure state, and any external blocker."""Submit the bounded backlog objective to the already-deployed Governor and wait for terminal evidence."""
    request = """Take the oldest ten currently open LifeOS issues that do not require human credentials, consent, physical intervention, or policy decisions. For each issue, determine the underlying current requirement, repair or implement it where still required, then execute item-specific live acceptance against the production system. Continue autonomously through failures using Governor, Engineer and Tower according to the current routing/privacy policy. Do not treat historical merge state or broad regression health as acceptance. Archive sanitised evidence in lifeos-jobs, add the live evidence to the corresponding GitHub issue, and close/archive it only when LIVE-PROVEN COMPLETE or demonstrably OBSOLETE/SUPERSEDED. Skip human-boundary issues and continue to the next eligible issue until ten eligible issues have been closed with evidence. Finish with RESULT=PASS and CLOSED_COUNT=10 only after all ten are evidenced and archived."""
    payload = json.dumps({"request": request, "privacy_domain": "personal-administration"}).encode()
    req = urllib.request.Request(
        AGENT_URL + "/jobs?async=1", data=payload,
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            job = json.loads(response.read())
    except Exception as exc:
        fault(faults, "GOVERNOR_SUBMISSION_FAILED", "critical", "governor",
              "Could not submit the ten-issue mission to Governor.", type(exc).__name__,
              "Repair the local Governor API/service and rerun.")
        return {"rc": 20, "job_id": None, "status": "SUBMISSION_FAILED"}

    job_id = str(job.get("id") or "")
    if not job_id:
        fault(faults, "GOVERNOR_SUBMISSION_INVALID", "critical", "governor",
              "Governor accepted no usable job id.", job,
              "Repair Governor job submission response and rerun.")
        return {"rc": 20, "job_id": None, "status": "SUBMISSION_INVALID"}

    print(f"GOVERNOR_JOB_ID={job_id}", flush=True)
    deadline = time.monotonic() + 2100
    latest = job
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(AGENT_URL + "/jobs/" + job_id, timeout=20) as response:
                latest = json.loads(response.read())
        except Exception:
            time.sleep(10)
            continue
        status = str(latest.get("status") or "").upper()
        print(f"GOVERNOR_JOB_STATUS={status}", flush=True)
        if status in {"PASS", "BLOCKED", "FAIL", "FAILED", "CANCELLED"}:
            break
        time.sleep(15)

    status = str(latest.get("status") or "").upper()
    evidence = "\n".join(str(x.get("evidence") or "") for x in latest.get("iterations", []))
    passed = status == "PASS" and "CLOSED_COUNT=10" in evidence and "RESULT=PASS" in evidence
    if not passed:
        fault(faults, "GOVERNOR_MISSION_INCOMPLETE", "high", "governor",
              "Autonomous ten-issue mission did not prove the required terminal contract.",
              {"job_id": job_id, "status": status, "blocked_reason": latest.get("blocked_reason")},
              "Resume/fix the Governor job; do not claim the ten issues complete.")
    return {"rc": 0 if passed else 20, "job_id": job_id, "status": status}

def render(faults, state, audit_result):
    write(FJ, json.dumps({"generated_at": now(), "version": VERSION,
                         "phase": state.get("phase"), "faults": faults},
                        indent=2, sort_keys=True) + "\n")
    lines = ["# LifeOS Personal Administration — Work bundle", "",
             f"Phase: `{state.get('phase')}`", "Governor: `minimal`", "",
             "Execution path: deterministic Pi scripts → local AI through ai_broker only when useful → deterministic verification.",
             "Governor autonomous jobs are permitted through the existing governed agent; privacy and execution routing remain enforced.", ""]
    if faults:
        lines += ["## Faults", ""]
        for f in faults:
            lines += [f"### {f['root_cause']} — {f['severity'].upper()}",
                      f"- {f['problem']}", f"- Evidence: `{f['evidence']}`",
                      f"- Action: {f['suggested_action']}", ""]
    else:
        lines += ["## Status", "", "No controller/executor faults detected.", ""]
    write(FM, "\n".join(lines) + "\n")

    acceptance = {
        "REPO_CLEAN_ALIGNED": "PASS" if audit_result.get("repo", {}).get("aligned") and not audit_result.get("repo", {}).get("dirty") else "BLOCKED",
        "RUNTIME_VISIBLE": "PASS" if audit_result.get("docker", {}).get("available") else "BLOCKED",
        "GOVERNOR_MODE": "MINIMAL",
        "GOVERNOR_AUTONOMY": "ENABLED_GOVERNED",
        "PA_SCRIPTED_EXECUTION": "PASS" if state.get("phase") == "scripted_execution_passed" else "INCOMPLETE",
    }
    summary = ["# Personal Administration mission status", "",
               f"- Generated: `{now()}`", f"- Phase: `{state.get('phase')}`", "",
               "## Acceptance", ""]
    summary += [f"- `{k}`: **{v}**" for k, v in acceptance.items()]
    write(SM, "\n".join(summary) + "\n")


def print_status(state):
    print(f"RUNNER_VERSION={VERSION}")
    print(f"MISSION_PHASE={state.get('phase', 'unknown')}")
    print("GOVERNOR_MODE=minimal")
    print("GOVERNOR_AUTONOMY=enabled_governed")
    if state.get("executor_rc") is not None:
        print(f"EXECUTOR_RC={state.get('executor_rc')}")
    print(f"STATE_DIR={STATE}")
    print(f"WORK_BUNDLE={FM}")
    print(f"SUMMARY={SM}")


def lock():
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    try:
        fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except FileExistsError:
        try:
            pid = int(LOCK.read_text())
            os.kill(pid, 0)
            raise SystemExit(f"RUNNER_ALREADY_ACTIVE pid={pid}")
        except (ProcessLookupError, ValueError, OSError):
            LOCK.unlink(missing_ok=True)
            lock()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", nargs="?", choices=("run", "resume", "audit", "status"), default="run")
    args = ap.parse_args()
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)

    if args.mode == "status":
        print_status(state_load())
        return 0

    lock()
    try:
        state = state_load()
        faults = []
        print("STAGE=deterministic_audit", flush=True)
        audit_result = audit(faults)
        hard = {"CANONICAL_REPO_UNAVAILABLE", "CANONICAL_REPO_DIRTY",
                "CANONICAL_REPO_DRIFT", "GITHUB_SYNC_UNAVAILABLE"}
        roots = {x["root_cause"] for x in faults}

        if roots & hard:
            state["phase"] = "baseline_blocked"
            state["executor_rc"] = None
        elif args.mode == "audit":
            state["phase"] = "audit_passed"
            state["executor_rc"] = None
        else:
            execution = run_executor(faults)
            state["executor_rc"] = execution["rc"]
            if execution["rc"] == 0:
                mission = run_autonomous_mission(faults)
                state["governor_job_id"] = mission.get("job_id")
                state["phase"] = "autonomous_mission_passed" if mission["rc"] == 0 else "autonomous_mission_blocked"
            else:
                state["phase"] = "scripted_execution_blocked"

        state_save(state)
        render(faults, state, audit_result)
        print_status(state)

        if roots & hard:
            print("RESULT=SAFE_STOP")
            return 40
        if state.get("phase") in {"scripted_execution_blocked", "autonomous_mission_blocked"} or faults:
            print("RESULT=WORK_BUNDLE_READY")
            return 20
        print("RESULT=PASS")
        return 0
    finally:
        LOCK.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())
