#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import platform
import shutil
import socket
import subprocess

VERSION = "2026.09.09-2"
REPO = pathlib.Path(os.getenv("LIFEOS_PLATFORM_REPO", "/home/joshan/lifeos-platform"))
STATE = pathlib.Path(os.getenv("LIFEOS_PA_MISSION_STATE", str(pathlib.Path.home() / ".local/state/lifeos-pa-autonomy")))
SF = STATE / "state.json"
AF = STATE / "audit.json"
FJ = STATE / "fault-bundle.json"
FM = STATE / "WORK_BUNDLE.md"
SM = STATE / "SUMMARY.md"
LOCK = STATE / "runner.lock"
MINFREE = float(os.getenv("LIFEOS_PA_MIN_FREE_GIB", "2"))

# Governor is deliberately minimal now. The autonomous-agent/job API is NOT a
# mission dependency. Its accepted scope is only Tower lifecycle + local AI.
MINIMAL_GOVERNOR_SERVICES = {
    "lifeos-autonomous-agent.service",
    "lifeos-autonomous-agent.timer",
    "lifeos-backlog-runner.service",
    "lifeos-backlog-runner.timer",
}


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def cmd(argv, cwd=None, timeout=30):
    try:
        p = subprocess.run(argv, cwd=str(cwd) if cwd else None, text=True,
                           capture_output=True, timeout=timeout)
        return {"rc": p.returncode, "out": (p.stdout or "").strip(),
                "err": (p.stderr or "").strip()}
    except FileNotFoundError:
        return {"rc": 127, "out": "", "err": "command_not_found"}
    except subprocess.TimeoutExpired:
        return {"rc": 124, "out": "", "err": "timeout"}
    except Exception as exc:
        return {"rc": 125, "out": "", "err": type(exc).__name__}


def write(path: pathlib.Path, text: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def state_load():
    try:
        return json.loads(SF.read_text(encoding="utf-8"))
    except Exception:
        return {"schema": 2, "version": VERSION, "created_at": now(),
                "phase": "new", "history": []}


def state_save(state):
    state.update(schema=2, version=VERSION, updated_at=now())
    write(SF, json.dumps(state, indent=2, sort_keys=True) + "\n")


def add(faults, root, severity, component, problem, evidence, action, human=False):
    faults.append({
        "root_cause": root,
        "severity": severity,
        "component": component,
        "problem": problem,
        "evidence": str(evidence)[:1600],
        "suggested_action": action,
        "human_boundary": human,
    })


def host_audit(faults):
    base = REPO if REPO.exists() else pathlib.Path.home()
    du = shutil.disk_usage(base)
    result = {
        "hostname": socket.gethostname(),
        "architecture": platform.machine(),
        "disk_free_gib": round(du.free / 1073741824, 2),
    }
    if result["disk_free_gib"] < MINFREE:
        add(faults, "RESOURCE_PRESSURE", "high", "pi5", "Low free disk space.",
            result, "Free space using existing retention paths; do not delete unknown data.")
    return result


def repo_audit(faults):
    if not (REPO / ".git").exists():
        add(faults, "CANONICAL_REPO_UNAVAILABLE", "critical", "repository",
            "Canonical checkout missing.", REPO,
            "Restore the canonical checkout; do not create another source of truth.")
        return {"exists": False}

    status = cmd(["git", "status", "--porcelain", "--untracked-files=all"], REPO)
    head = cmd(["git", "rev-parse", "HEAD"], REPO)
    branch = cmd(["git", "branch", "--show-current"], REPO)
    fetch = cmd(["git", "fetch", "--prune", "origin", "main"], REPO, 90)
    origin = cmd(["git", "rev-parse", "origin/main"], REPO)
    dirty = bool(status["out"])
    aligned = bool(head["out"]) and head["out"] == origin["out"]
    result = {"exists": True, "branch": branch["out"], "head": head["out"],
              "origin_main": origin["out"], "dirty": dirty, "aligned": aligned,
              "fetch_rc": fetch["rc"]}
    if dirty:
        add(faults, "CANONICAL_REPO_DIRTY", "critical", "repository",
            "Canonical checkout has local changes; runner will not clean/reset it.",
            "dirty=true", "Preserve/reconcile changes; never reset --hard or git clean.")
    if fetch["rc"] != 0:
        add(faults, "GITHUB_SYNC_UNAVAILABLE", "high", "repository",
            "Could not refresh origin/main.", fetch["err"][:300],
            "Repair network/auth and rerun.")
    elif not aligned:
        add(faults, "CANONICAL_REPO_DRIFT", "critical", "repository",
            "Pi HEAD differs from origin/main.", result,
            "Fast-forward only after proving the worktree is clean.")
    return result


def docker_audit(faults):
    p = cmd(["docker", "ps", "--format", "{{.Names}}\t{{.Image}}\t{{.Status}}"], timeout=20)
    if p["rc"] != 0:
        add(faults, "DOCKER_UNAVAILABLE", "high", "runtime", "Docker inventory failed.",
            p["err"][:300], "Restore existing Docker access/service.")
        return {"available": False, "containers": []}
    rows = []
    for line in p["out"].splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            rows.append({"name": parts[0], "image": parts[1], "status": parts[2]})
    hay = "\n".join((x["name"] + " " + x["image"]).lower() for x in rows)
    return {"available": True, "container_count": len(rows),
            "homeassistant": "homeassistant" in hay or "home-assistant" in hay,
            "paperless": "paperless" in hay,
            "mosquitto": "mosquitto" in hay}


def service_state(name):
    r = cmd(["systemctl", "is-active", name], timeout=10)
    return r["out"] or "unknown"


def minimal_governor_audit(faults, run_inference=True):
    services = {name: service_state(name) for name in sorted(MINIMAL_GOVERNOR_SERVICES)}

    # Disabled/inactive autonomous services are expected in minimal mode.
    unexpected = {k: v for k, v in services.items()
                  if k == "lifeos-autonomous-agent.service" and v == "active"}
    if unexpected:
        add(faults, "GOVERNOR_SCOPE_DRIFT", "warning", "governor",
            "Autonomous-agent service is active while Governor is in minimal mode.",
            unexpected, "Keep autonomous job orchestration disabled until minimal acceptance is stable.")

    result = {"mode": "minimal", "services": services, "local_ai_test": "not_run"}
    if not run_inference:
        return result

    # Test the one Governor capability we currently rely on. ai_broker._ollama
    # owns the lease, tries Ollama, wakes Tower by WoL if required, waits for it,
    # and releases the lease in finally.
    probe = cmd([
        "python3", "-c",
        "import sys; sys.path.insert(0, '/home/joshan/lifeos-platform'); "
        "from governor import ai_broker; "
        "r=ai_broker._ollama('Reply with exactly: LOCAL_AI_OK', ai_broker.OLLAMA_MODEL); "
        "print(r.strip()); raise SystemExit(0 if 'LOCAL_AI_OK' in r else 9)"
    ], cwd=REPO, timeout=180)
    result.update(local_ai_test="pass" if probe["rc"] == 0 else "fail",
                  local_ai_reply=probe["out"][-200:], local_ai_rc=probe["rc"])
    if probe["rc"] != 0:
        add(faults, "MINIMAL_GOVERNOR_FAILED", "critical", "governor",
            "Tower lifecycle/local AI baseline failed.",
            {"rc": probe["rc"], "out": probe["out"][-200:], "err": probe["err"][-300:]},
            "Repair only Tower wake, local Ollama routing, lease release/shutdown; do not re-enable autonomous orchestration.")
    return result


def acceptance(audit):
    repo = audit["repo"]
    docker = audit["docker"]
    gov = audit["governor"]
    return {
        "BASELINE_REPO_CLEAN": "PASS" if repo.get("aligned") and not repo.get("dirty") else "BLOCKED",
        "BASELINE_RUNTIME_VISIBLE": "PASS" if docker.get("available") else "BLOCKED",
        "BASELINE_GOVERNOR_MINIMAL": "PASS" if gov.get("local_ai_test") == "pass" else "BLOCKED",
        "GOVERNOR_AUTONOMOUS_JOBS": "DISABLED_BY_DESIGN",
        "PA_CALENDAR_EMAIL_PAPERLESS": "READY_FOR_SCRIPTED_EXECUTION",
    }


def audit_all(faults, run_inference=True):
    result = {"generated_at": now(), "runner_version": VERSION}
    result["host"] = host_audit(faults)
    result["repo"] = repo_audit(faults)
    result["docker"] = docker_audit(faults)
    result["governor"] = minimal_governor_audit(faults, run_inference=run_inference)
    result["acceptance"] = acceptance(result)
    write(AF, json.dumps(result, indent=2, sort_keys=True) + "\n")
    return result


def groups(faults):
    rank = {"info": 0, "warning": 1, "medium": 2, "high": 3, "critical": 4}
    grouped = {}
    for f in faults:
        g = grouped.setdefault(f["root_cause"], {"root_cause": f["root_cause"],
            "severity": f["severity"], "human_boundary": False, "items": []})
        g["items"].append(f)
        g["human_boundary"] |= f.get("human_boundary", False)
        if rank.get(f["severity"], 0) > rank.get(g["severity"], 0):
            g["severity"] = f["severity"]
    return sorted(grouped.values(), key=lambda x: rank.get(x["severity"], 0), reverse=True)


def render(faults, state, audit):
    gs = groups(faults)
    write(FJ, json.dumps({"generated_at": now(), "version": VERSION,
                         "phase": state.get("phase"), "groups": gs},
                        indent=2, sort_keys=True) + "\n")

    lines = [
        "# LifeOS Personal Administration — Work bundle",
        "",
        f"Phase: `{state.get('phase')}`",
        "Governor mode: `minimal`",
        "",
        "## Execution rule",
        "",
        "Governor autonomous-job orchestration is intentionally disabled. Do not wait for or repair the old /jobs API. Use deterministic Pi-side scripts/tools for PA delivery. Use governor.ai_broker only when local AI reasoning is useful; it owns Tower wake + local Ollama + lease release. Preserve Watchman/root protections and local-only privacy. GitHub remains source/history, not the execution bus.",
        "",
        "## Current mission",
        "",
        "Continue Personal Administration issue #164: integrate existing Calendar + Email + Paperless into the existing PA attention surface. Inspect live state first, reuse working services, OTS/native first, and implement/test/deploy in bounded scripted batches. Do not send private source content to cloud AI/GitHub/logs.",
        "",
    ]
    if not gs:
        lines += ["## Baseline", "", "Minimal Governor baseline PASS. Mission may proceed with scripted execution.", ""]
    else:
        lines += ["## Faults", ""]
        for i, g in enumerate(gs, 1):
            lines += [f"### {i}. {g['root_cause']} — {g['severity'].upper()}"]
            for item in g["items"]:
                lines += [f"- {item['component']}: {item['problem']}",
                          f"  - Evidence: `{item['evidence']}`",
                          f"  - Action: {item['suggested_action']}"]
            lines.append("")
    write(FM, "\n".join(lines) + "\n")

    summary = [
        "# Personal Administration mission status", "",
        f"- Generated: `{now()}`",
        f"- Phase: `{state.get('phase')}`",
        "- Governor mode: `minimal`",
        f"- Fault groups: `{len(gs)}`", "", "## Acceptance", "",
    ]
    summary += [f"- `{k}`: **{v}**" for k, v in audit["acceptance"].items()]
    write(SM, "\n".join(summary) + "\n")


def print_status(state):
    print(f"RUNNER_VERSION={VERSION}")
    print(f"MISSION_PHASE={state.get('phase', 'unknown')}")
    print("GOVERNOR_MODE=minimal")
    print("GOVERNOR_AUTONOMY=disabled")
    print(f"STATE_DIR={STATE}")
    print(f"WORK_BUNDLE={FM}")
    print(f"SUMMARY={SM}")


def lock():
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    try:
        fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except FileExistsError:
        try:
            pid = int(LOCK.read_text())
            os.kill(pid, 0)
            raise SystemExit(f"RUNNER_ALREADY_ACTIVE pid={pid}")
        except (ProcessLookupError, ValueError, OSError):
            LOCK.unlink(missing_ok=True)
            lock()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", nargs="?", choices=("run", "resume", "audit", "status"), default="run")
    args = ap.parse_args()
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)

    if args.mode == "status":
        print_status(state_load())
        return 0

    lock()
    try:
        state = state_load()
        faults = []
        print("STAGE=deterministic_audit", flush=True)
        audit = audit_all(faults, run_inference=True)

        hard = {"CANONICAL_REPO_UNAVAILABLE", "CANONICAL_REPO_DIRTY",
                "CANONICAL_REPO_DRIFT", "MINIMAL_GOVERNOR_FAILED"}
        roots = {f["root_cause"] for f in faults}
        if roots & hard:
            state["phase"] = "baseline_blocked"
        elif args.mode == "audit":
            state["phase"] = "audit_passed"
        else:
            # Mission execution is now explicitly scripted/supervised rather
            # than submitted to the disabled autonomous Governor job engine.
            state["phase"] = "ready_for_scripted_execution"

        render(faults, state, audit)
        state_save(state)
        print_status(state)

        gs = groups(faults)
        if roots & hard:
            print("RESULT=SAFE_STOP")
            return 40
        if gs:
            print("RESULT=WORK_BUNDLE_READY")
            return 20
        print("RESULT=PASS")
        return 0
    finally:
        LOCK.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())
