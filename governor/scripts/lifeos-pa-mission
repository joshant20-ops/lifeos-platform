#!/usr/bin/env python3
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import platform
import shutil
import socket
import subprocess
import urllib.request
import urllib.error
import time

VERSION = "2026.09.20-12"
REPO = pathlib.Path(os.getenv("LIFEOS_PLATFORM_REPO", "/home/joshan/lifeos-platform"))
STATE = pathlib.Path(os.getenv("LIFEOS_PA_MISSION_STATE", str(pathlib.Path.home() / ".local/state/lifeos-pa-autonomy")))
SF = STATE / "state.json"
AF = STATE / "audit.json"
FJ = STATE / "fault-bundle.json"
FM = STATE / "WORK_BUNDLE.md"
SM = STATE / "SUMMARY.md"
LOCK = STATE / "runner.lock"
EXECUTOR = REPO / "governor/scripts/lifeos-pa-execute"
AGENT_URL = os.getenv("LIFEOS_AGENT_URL", "http://127.0.0.1:8790")
MINFREE = float(os.getenv("LIFEOS_PA_MIN_FREE_GIB", "2"))
AUTONOMY_UNITS = (
    "lifeos-autonomous-agent.service",
    "lifeos-autonomous-agent.timer",
    "lifeos-backlog-runner.timer",
)


def now():
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def cmd(argv, cwd=None, timeout=60):
    try:
        p = subprocess.run(argv, cwd=str(cwd) if cwd else None, text=True,
                           capture_output=True, timeout=timeout)
        return {"rc": p.returncode, "out": (p.stdout or "").strip(),
                "err": (p.stderr or "").strip()}
    except FileNotFoundError:
        return {"rc": 127, "out": "", "err": "command_not_found"}
    except subprocess.TimeoutExpired:
        return {"rc": 124, "out": "", "err": "timeout"}
    except Exception as exc:
        return {"rc": 125, "out": "", "err": type(exc).__name__}


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def state_load():
    try:
        return json.loads(SF.read_text(encoding="utf-8"))
    except Exception:
        return {"schema": 3, "created_at": now(), "phase": "new", "history": []}


def state_save(state):
    state.update(schema=3, version=VERSION, updated_at=now())
    write(SF, json.dumps(state, indent=2, sort_keys=True) + "\n")


def fault(faults, root, severity, component, problem, evidence, action):
    faults.append({"root_cause": root, "severity": severity, "component": component,
                   "problem": problem, "evidence": str(evidence)[:1800],
                   "suggested_action": action})


def service_state(name):
    r = cmd(["systemctl", "is-active", name], timeout=10)
    return r["out"] or "unknown"


def audit(faults):
    result = {"generated_at": now(), "runner_version": VERSION}
    base = REPO if REPO.exists() else pathlib.Path.home()
    du = shutil.disk_usage(base)
    result["host"] = {"hostname": socket.gethostname(),
                      "architecture": platform.machine(),
                      "disk_free_gib": round(du.free / 1073741824, 2)}
    if result["host"]["disk_free_gib"] < MINFREE:
        fault(faults, "RESOURCE_PRESSURE", "high", "pi5", "Low free disk space.",
              result["host"], "Free space using existing retention paths.")

    if not (REPO / ".git").exists():
        fault(faults, "CANONICAL_REPO_UNAVAILABLE", "critical", "repository",
              "Canonical checkout missing.", REPO, "Restore canonical checkout.")
        result["repo"] = {"exists": False}
    else:
        st = cmd(["git", "status", "--porcelain", "--untracked-files=all"], REPO)
        head = cmd(["git", "rev-parse", "HEAD"], REPO)
        fetch = cmd(["git", "fetch", "--prune", "origin", "main"], REPO, 90)
        origin = cmd(["git", "rev-parse", "origin/main"], REPO)
        dirty = bool(st["out"])
        aligned = bool(head["out"]) and head["out"] == origin["out"]
        result["repo"] = {"exists": True, "head": head["out"],
                          "origin_main": origin["out"], "dirty": dirty,
                          "aligned": aligned, "fetch_rc": fetch["rc"]}
        if dirty:
            fault(faults, "CANONICAL_REPO_DIRTY", "critical", "repository",
                  "Canonical checkout has local changes.", st["out"][:1000],
                  "Preserve/reconcile them; never reset --hard or git clean.")
        if fetch["rc"] != 0:
            fault(faults, "GITHUB_SYNC_UNAVAILABLE", "high", "repository",
                  "Could not refresh origin/main.", fetch["err"][:500],
                  "Repair GitHub/network access and rerun.")
        elif not aligned:
            fault(faults, "CANONICAL_REPO_DRIFT", "critical", "repository",
                  "Pi checkout is not at origin/main.", result["repo"],
                  "Fast-forward the clean checkout before execution.")

    docker = cmd(["docker", "ps", "--format", "{{.Names}}\t{{.Image}}"], timeout=20)
    result["docker"] = {"available": docker["rc"] == 0}
    if docker["rc"] == 0:
        hay = docker["out"].lower()
        result["docker"].update(homeassistant="homeassistant" in hay or "home-assistant" in hay,
                                paperless="paperless" in hay,
                                mosquitto="mosquitto" in hay)
    else:
        fault(faults, "DOCKER_UNAVAILABLE", "high", "runtime",
              "Docker inventory failed.", docker["err"][:500],
              "Restore existing Docker access/service.")

    services = {x: service_state(x) for x in AUTONOMY_UNITS}
    result["governor"] = {"mode": "minimal", "services": services,
                          "autonomy": "available"}
    if services.get("lifeos-autonomous-agent.service") == "active":
        fault(faults, "GOVERNOR_SCOPE_DRIFT", "warning", "governor",
              "Autonomous agent is active in minimal mode.", services,
              "Autonomous orchestration is allowed only through the governed mission path; retain privacy and routing enforcement.")

    write(AF, json.dumps(result, indent=2, sort_keys=True) + "\n")
    return result


def run_executor(faults):
    if not EXECUTOR.is_file():
        fault(faults, "PA_EXECUTOR_MISSING", "critical", "personal-administration",
              "Scripted PA executor is missing.", EXECUTOR,
              "Restore governor/scripts/lifeos-pa-execute from canonical main.")
        return {"rc": 127, "out": "", "err": "executor_missing"}

    # A targeted ledger-disposition mission is governed by the explicit single-issue
    # objective below. The broad PA executor inspects the whole PA/PIP corpus and can
    # block a targeted mission on unrelated work, which defeats item-specific auditing.
    # Keep it for general PA runs, but do not make unrelated PA/PIP findings a gate for
    # an explicitly scoped ledger issue.
    if os.getenv("LIFEOS_PA_TARGET_ISSUE"):
        print("STAGE=scripted_execution", flush=True)
        print("SCRIPTED_EXECUTION=SKIPPED_TARGETED_ISSUE", flush=True)
        return {"rc": 0, "out": "targeted_issue_scope", "err": ""}

    print("STAGE=scripted_execution", flush=True)
    result = cmd(["python3", str(EXECUTOR)], REPO, timeout=420)
    if result["out"]:
        print(result["out"], flush=True)
    if result["err"]:
        print(result["err"][-1200:], flush=True)
    if result["rc"] != 0:
        fault(faults, "PA_SCRIPTED_EXECUTION_BLOCKED", "high", "personal-administration",
              "Scripted PA executor did not reach PASS.",
              {"rc": result["rc"], "out": result["out"][-1500:], "err": result["err"][-800:]},
              "Use SCRIPTED_PLAN.json/SCRIPTED_RESULT.json to fix the bounded root cause; do not re-enable Governor autonomy.")
    return result


def run_autonomous_mission(faults):
    """Submit the bounded backlog objective to the already-deployed Governor and wait for terminal evidence."""
    request = """Process exactly one autonomous-safe unresolved LifeOS issue: #418 — Engineer: GitHub issue-to-Engineer/Governor pickup path.\n\nThis is the post-smoke end-to-end acceptance run. Component smoke is green; exercise the real governed pickup path and do not declare PASS unless current item-specific evidence proves the complete transaction.

Inspect canonical main and the live current architecture. Determine whether the historical issue-to-Engineer pickup requirement is already satisfied by the current Governor, mission-control, backlog, and governed engineering paths, or whether a current gap remains. Test the actual current path end-to-end where safe. Prefer the current architecture over recreating obsolete historical mechanisms.

Close #418 only with item-specific current evidence proving COMPLETE, OBSOLETE/SUPERSEDED, or DUPLICATE, and archive sanitised disposition/evidence in lifeos-jobs before closure. If a genuine user-only blocker exists, leave it open and state it precisely.

Preserve invariants: Pi5 orchestration/control only; private data local-only; Tower Ollama demand-powered via governed lease/WoL; no cloud fallback for private work; no sudo assumption; Git changes through governed branch/PR publication.

Final status must explicitly report:
RESULT=PASS
CLOSED_COUNT=1
ISSUE_DISPOSITIONS=#418 with tests/simulations, live evidence references and closure state
Only emit RESULT=PASS/CLOSED_COUNT=1 when #418 has an evidence-backed terminal disposition."""
    payload = json.dumps({"request": request, "privacy_domain": "personal-administration"}).encode()
    req = urllib.request.Request(
        AGENT_URL + "/jobs?async=1", data=payload,
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=20) as response:
            job = json.loads(response.read())
    except Exception as exc:
        fault(faults, "GOVERNOR_SUBMISSION_FAILED", "critical", "governor",
              "Could not submit the ten-issue mission to Governor.", type(exc).__name__,
              "Repair the local Governor API/service and rerun.")
        return {"rc": 20, "job_id": None, "status": "SUBMISSION_FAILED"}

    job_id = str(job.get("id") or "")
    if not job_id:
        fault(faults, "GOVERNOR_SUBMISSION_INVALID", "critical", "governor",
              "Governor accepted no usable job id.", job,
              "Repair Governor job submission response and rerun.")
        return {"rc": 20, "job_id": None, "status": "SUBMISSION_INVALID"}

    print(f"GOVERNOR_JOB_ID={job_id}", flush=True)
    deadline = time.monotonic() + 1050
    latest = job
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(AGENT_URL + "/jobs/" + job_id, timeout=20) as response:
                latest = json.loads(response.read())
        except Exception:
            time.sleep(10)
            continue
        status = str(latest.get("status") or "").upper()
        print(f"GOVERNOR_JOB_STATUS={status}", flush=True)
        if status in {"PASS", "BLOCKED", "FAIL", "FAILED", "CANCELLED"}:
            break
        time.sleep(15)

    status = str(latest.get("status") or "").upper()
    if time.monotonic() >= deadline and status not in {"PASS", "BLOCKED", "FAIL", "FAILED", "CANCELLED"}:
        status = "TIMEOUT"
        print("GOVERNOR_JOB_STATUS=TIMEOUT", flush=True)
    evidence = "\n".join(str(x.get("evidence") or "") for x in latest.get("iterations", []))
    passed = status == "PASS" and "CLOSED_COUNT=1" in evidence and "RESULT=PASS" in evidence
    if not passed:
        fault(faults, "GOVERNOR_MISSION_INCOMPLETE", "high", "governor",
              "Autonomous single-issue mission did not prove the required terminal contract.",
              {"job_id": job_id, "status": status, "blocked_reason": latest.get("blocked_reason")},
              "Resume/fix the Governor job; do not claim the issue complete.")
    return {"rc": 0 if passed else 20, "job_id": job_id, "status": status}

def render(faults, state, audit_result):
    write(FJ, json.dumps({"generated_at": now(), "version": VERSION,
                         "phase": state.get("phase"), "faults": faults},
                        indent=2, sort_keys=True) + "\n")
    lines = ["# LifeOS Personal Administration — Work bundle", "",
             f"Phase: `{state.get('phase')}`", "Governor: `minimal`", "",
             "Execution path: deterministic Pi scripts → local AI through ai_broker only when useful → deterministic verification.",
             "Governor autonomous jobs are permitted through the existing governed agent; privacy and execution routing remain enforced.", ""]
    if faults:
        lines += ["## Faults", ""]
        for f in faults:
            lines += [f"### {f['root_cause']} — {f['severity'].upper()}",
                      f"- {f['problem']}", f"- Evidence: `{f['evidence']}`",
                      f"- Action: {f['suggested_action']}", ""]
    else:
        lines += ["## Status", "", "No controller/executor faults detected.", ""]
    write(FM, "\n".join(lines) + "\n")

    acceptance = {
        "REPO_CLEAN_ALIGNED": "PASS" if audit_result.get("repo", {}).get("aligned") and not audit_result.get("repo", {}).get("dirty") else "BLOCKED",
        "RUNTIME_VISIBLE": "PASS" if audit_result.get("docker", {}).get("available") else "BLOCKED",
        "GOVERNOR_MODE": "MINIMAL",
        "GOVERNOR_AUTONOMY": "ENABLED_GOVERNED",
        "PA_SCRIPTED_EXECUTION": "PASS" if state.get("phase") == "scripted_execution_passed" else "INCOMPLETE",
    }
    summary = ["# Personal Administration mission status", "",
               f"- Generated: `{now()}`", f"- Phase: `{state.get('phase')}`", "",
               "## Acceptance", ""]
    summary += [f"- `{k}`: **{v}**" for k, v in acceptance.items()]
    write(SM, "\n".join(summary) + "\n")


def print_status(state):
    print(f"RUNNER_VERSION={VERSION}")
    print(f"MISSION_PHASE={state.get('phase', 'unknown')}")
    print("GOVERNOR_MODE=minimal")
    print("GOVERNOR_AUTONOMY=enabled_governed")
    if state.get("executor_rc") is not None:
        print(f"EXECUTOR_RC={state.get('executor_rc')}")
    print(f"STATE_DIR={STATE}")
    print(f"WORK_BUNDLE={FM}")
    print(f"SUMMARY={SM}")


def lock():
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    try:
        fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except FileExistsError:
        try:
            pid = int(LOCK.read_text())
            os.kill(pid, 0)
            raise SystemExit(f"RUNNER_ALREADY_ACTIVE pid={pid}")
        except (ProcessLookupError, ValueError, OSError):
            LOCK.unlink(missing_ok=True)
            lock()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("mode", nargs="?", choices=("run", "resume", "audit", "status"), default="run")
    args = ap.parse_args()
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)

    if args.mode == "status":
        print_status(state_load())
        return 0

    lock()
    try:
        state = state_load()
        faults = []
        print("STAGE=deterministic_audit", flush=True)
        audit_result = audit(faults)
        hard = {"CANONICAL_REPO_UNAVAILABLE", "CANONICAL_REPO_DIRTY",
                "CANONICAL_REPO_DRIFT", "GITHUB_SYNC_UNAVAILABLE"}
        roots = {x["root_cause"] for x in faults}

        if roots & hard:
            state["phase"] = "baseline_blocked"
            state["executor_rc"] = None
        elif args.mode == "audit":
            state["phase"] = "audit_passed"
            state["executor_rc"] = None
        else:
            # Targeted ledger missions are already explicitly scoped below. Do not
            # gate them on the broad PA planning executor: that planner can fail on
            # unrelated PA source/JSON planning and previously invoked a cloud
            # repair path, preventing the local-only #418 mission from starting.
            print("STAGE=targeted_issue_mission", flush=True)
            state["executor_rc"] = 0
            mission = run_autonomous_mission(faults)
            state["governor_job_id"] = mission.get("job_id")
            state["phase"] = "autonomous_mission_passed" if mission["rc"] == 0 else "autonomous_mission_blocked"

        state_save(state)
        render(faults, state, audit_result)
        print_status(state)

        if roots & hard:
            print("RESULT=SAFE_STOP")
            return 40
        if state.get("phase") in {"scripted_execution_blocked", "autonomous_mission_blocked"} or faults:
            print("RESULT=WORK_BUNDLE_READY")
            return 20
        print("RESULT=PASS")
        return 0
    finally:
        LOCK.unlink(missing_ok=True)


if __name__ == "__main__":
    raise SystemExit(main())
