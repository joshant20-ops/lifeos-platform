#!/usr/bin/env bash
set -euo pipefail

CONTROLLER_REPO=${LIFEOS_PLATFORM_REPO:-/home/joshan/lifeos-platform}
ENGINEER=${LIFEOS_ENGINEER_SSH:-Engineer}
REPO=${LIFEOS_ENGINEER_REPO:-/home/joshan/workspace/lifeos-platform}
BROKER_TOKEN=${LIFEOS_AI_BROKER_TOKEN_FILE:-$HOME/.config/lifeos/ai-broker.token}
BROKER_URL=${LIFEOS_LOCAL_BROKER_URL:-http://127.0.0.1:8790/v1/chat/completions}
MODEL=${LIFEOS_LOCAL_BUILDER_MODEL:-openai/lifeos-local-only-normal}

release_lease() {
  python3 - "$CONTROLLER_REPO" <<'PY' >/dev/null 2>&1 || true
import importlib.util, pathlib, sys
p=pathlib.Path(sys.argv[1])/'governor'/'ai_broker.py'
s=importlib.util.spec_from_file_location('lifeos_local_builder_broker',p)
m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
m._publish_lease('released', required=False)
PY
}

self_test() {
  [[ -s "$BROKER_TOKEN" && ! -L "$BROKER_TOKEN" && "$(stat -c '%a' "$BROKER_TOKEN")" == 600 ]] || {
    echo 'LOCAL_BUILDER_SELFTEST=FAIL'; echo 'REASON=broker_token_unavailable'; return 20;
  }
  local req out rc
  req='{"model":"openai/lifeos-local-only-normal","messages":[{"role":"user","content":"Reply with exactly LOCAL_ONLY_ROUTE_OK"}]}'

  # The local-only broker is demand powered. A route self-test must exercise the
  # same lease/WoL readiness contract as a real local job instead of treating a
  # cold Tower as a broken route. Keep this fail-closed: no cloud fallback.
  python3 - "$CONTROLLER_REPO" <<'PY'
import importlib.util, pathlib, sys
p=pathlib.Path(sys.argv[1])/'governor'/'ai_broker.py'
s=importlib.util.spec_from_file_location('lifeos_local_builder_selftest_broker',p)
m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
m._publish_lease('active')
m._wake_local_ai()
PY
  trap release_lease RETURN

  out=''
  rc=1
  for attempt in $(seq 1 24); do
    set +e
    out=$(curl -fsS --max-time 15 -H 'Content-Type: application/json' \
      -H "Authorization: Bearer $(cat "$BROKER_TOKEN")" -d "$req" "$BROKER_URL")
    rc=$?
    set -e
    (( rc == 0 )) && break
    echo "LOCAL_BUILDER_SELFTEST_WAIT=local_route_not_ready attempt=$attempt" >&2
    sleep 5
  done
  if (( rc != 0 )); then
    echo 'LOCAL_BUILDER_SELFTEST=FAIL'; echo 'REASON=local_broker_unavailable_after_demand_wake'; return 20
  fi
  python3 - "$out" <<'PY'
import json,sys
j=json.loads(sys.argv[1])
assert j.get('lifeos_privacy') == 'local-only', j
assert j.get('lifeos_provider') == 'ollama', j
print('LOCAL_BUILDER_SELFTEST=PASS')
print('LOCAL_BUILDER_PROVIDER=ollama')
print('LOCAL_BUILDER_CLOUD_FALLBACK=DISABLED')
PY
}

if [[ ${1:-} == --self-test ]]; then
  self_test
  exit
fi

REQUEST=${1:?request required}
ITERATION=${2:?iteration required}
PRIVACY=${LIFEOS_JOB_PRIVACY:-}
JOB_ID=${LIFEOS_JOB_ID:-unknown}
RUNTIME_PATH="governor/runtime_jobs/${JOB_ID}.sh"

if [[ "$PRIVACY" != local-only ]]; then
  echo 'RESULT=BLOCKED'
  echo 'REASON=local_builder_requires_local_only_privacy'
  exit 42
fi
if [[ "$MODEL" != *local-only* ]]; then
  echo 'RESULT=BLOCKED'
  echo 'REASON=local_builder_model_must_be_local_only'
  exit 42
fi

PIPELINE_T0=$(date +%s)
checkpoint() { printf 'OPENHANDS_TRANSPORT_STAGE=%s elapsed_s=%s\n' "$1" "$(( $(date +%s)-PIPELINE_T0 ))"; }
echo 'LOCAL_BUILDER_ROUTE=Pi5_Governor_to_Tower_Ollama'
checkpoint local_builder_start
echo 'LOCAL_BUILDER_CLOUD_FALLBACK=DISABLED'

# Acquire the same Pi Governor/Tower lease used by local verification, then wait
# for the Engineer VM that boots with Tower. Any failure remains local and
# retryable; this wrapper never falls through to a cloud provider.
python3 - "$CONTROLLER_REPO" <<'PY'
import importlib.util, pathlib, sys
p=pathlib.Path(sys.argv[1])/'governor'/'ai_broker.py'
s=importlib.util.spec_from_file_location('lifeos_local_builder_broker',p)
m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
m._publish_lease('active')
m._wake_local_ai()
PY
checkpoint tower_wake_requested

# Keep the session-level compute lease alive for the whole OTS engineering
# session. Per-request broker leases are intentionally short-lived, but releasing
# one must not allow the Tower controller to power down while OpenHands is between
# model/tool turns. Refresh faster than the configured broker lease TTL.
LEASE_REFRESH_SECONDS=${LIFEOS_SESSION_LEASE_REFRESH_SECONDS:-60}
[[ "$LEASE_REFRESH_SECONDS" =~ ^[0-9]+$ ]] && (( LEASE_REFRESH_SECONDS >= 15 && LEASE_REFRESH_SECONDS <= 300 )) || {
  echo 'RESULT=BLOCKED'; echo 'REASON=invalid_session_lease_refresh'; exit 42;
}
refresh_session_lease() {
  while true; do
    sleep "$LEASE_REFRESH_SECONDS"
    python3 - "$CONTROLLER_REPO" <<'PY' >/dev/null 2>&1 || exit 1
import importlib.util, pathlib, sys
p=pathlib.Path(sys.argv[1])/'governor'/'ai_broker.py'
s=importlib.util.spec_from_file_location('lifeos_local_builder_lease_refresh',p)
m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
m._publish_lease('active')
PY
  done
}
refresh_session_lease &
LEASE_REFRESH_PID=$!
cleanup_session() {
  kill "$LEASE_REFRESH_PID" >/dev/null 2>&1 || true
  wait "$LEASE_REFRESH_PID" >/dev/null 2>&1 || true
  release_lease
}
trap cleanup_session EXIT
echo "SESSION_COMPUTE_LEASE=active refresh_s=$LEASE_REFRESH_SECONDS"

READY=0
echo 'ENGINEER_READINESS=waiting'
for attempt in $(seq 1 60); do
  if ssh -o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$ENGINEER" true >/dev/null 2>&1; then
    READY=1
    echo "ENGINEER_READINESS=ready attempt=$attempt"
    checkpoint engineer_ssh_ready
    break
  fi
  (( attempt % 5 == 0 )) && echo "ENGINEER_READINESS=waiting attempt=$attempt"
  sleep 3
done
if (( READY == 0 )); then
  echo 'RESULT=RETRY'
  echo 'REASON=engineer_not_ready_after_local_tower_wake'
  exit 21
fi

echo 'ENGINEER_DISCOVERY=START'
DISCOVERY=$(timeout --signal=TERM --kill-after=5s 30s ssh -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$ENGINEER" bash -s <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
if command -v openhands >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/openhands" ]]; then echo 'OPENHANDS=present'; else echo 'OPENHANDS=absent'; fi
cfg="$HOME/.config/lifeos/governor-broker.env"
if [[ -f "$cfg" && ! -L "$cfg" && "$(stat -c '%a' "$cfg")" == 600 ]] && grep -q '^LIFEOS_GOVERNOR_BROKER_URL=' "$cfg" && grep -q '^LIFEOS_GOVERNOR_BROKER_TOKEN=' "$cfg"; then echo 'GOVERNOR_BROKER=present'; else echo 'GOVERNOR_BROKER=absent'; fi
REMOTE
)
printf '%s\n' "$DISCOVERY"
echo 'ENGINEER_DISCOVERY=PASS'
checkpoint engineer_discovery_pass
grep -q '^OPENHANDS=present$' <<<"$DISCOVERY" || { echo 'RESULT=RETRY'; echo 'REASON=openhands_unavailable'; exit 21; }
grep -q '^GOVERNOR_BROKER=present$' <<<"$DISCOVERY" || { echo 'RESULT=RETRY'; echo 'REASON=governor_broker_capability_unavailable'; exit 21; }

PROMPT=$(cat <<EOF
You are the LOCAL-ONLY engineering builder for LifeOS autonomous job $JOB_ID.
All inference for this job must stay on the local Pi Governor -> Tower Ollama route. Cloud providers are forbidden.
Work toward the user's original goal until this iteration has produced a concrete, testable improvement.

SAFETY AND EXECUTION:
- Pi5/Docker owns policy, Git publication, runtime execution, and privileged deployment.
- OpenHands executes only on the local Engineer VM and receives only the Pi Governor broker capability.
- Never use provider API keys, Codex, Gemini, Groq, OpenRouter, or any direct cloud model.
- Do not commit, push, fetch, clone, or depend on GitHub/network access from inside OpenHands; Pi5 publishes handoff changes.
- Never copy private source content into Git, logs, patches, or runtime launchers.
- If runtime inspection/change is needed, create exactly one Pi5 launcher at $RUNTIME_PATH. It must start with #!/usr/bin/env bash, be non-interactive and timeout-aware.
- The local verifier decides completion.

REPOSITORY WORK:
- Work in the clean disposable worktree supplied by the wrapper.
- Make necessary changes and run focused tests.
- Leave changes uncommitted for Pi5 handoff.
- Do not merely explain; perform available engineering work.

USER GOAL:
$REQUEST

ITERATION: $ITERATION

Complete the engineering work and leave the worktree in the best testable state you can.
Governor, not the agent, makes the final acceptance decision.
EOF
)
PROMPT_B64=$(printf '%s' "$PROMPT" | base64 -w0)
SNAPSHOT=$(mktemp --suffix=.bundle)
trap 'rm -f "$SNAPSHOT"; cleanup_session' EXIT
git -C "$CONTROLLER_REPO" bundle create "$SNAPSHOT" HEAD
test -s "$SNAPSHOT"
REMOTE_SNAPSHOT=".cache/lifeos/${JOB_ID}.bundle"
echo 'ENGINEER_HANDOFF_PREPARE=START'
timeout --signal=TERM --kill-after=5s 30s ssh -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$ENGINEER" 'install -d -m 0700 "$HOME/.cache/lifeos"'
echo 'ENGINEER_HANDOFF_PREPARE=PASS'
checkpoint engineer_handoff_prepare_pass
echo 'ENGINEER_SNAPSHOT_TRANSFER=START'
timeout --signal=TERM --kill-after=5s 60s scp -q -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$SNAPSHOT" "$ENGINEER:$REMOTE_SNAPSHOT"
echo 'ENGINEER_SNAPSHOT_TRANSFER=PASS'
checkpoint engineer_snapshot_transfer_pass

echo "AGENT_SESSION=openhands provider=governor-broker-local-only"
checkpoint remote_agent_launch
  set +e
  # Preserve stderr with stdout: OpenHands/timeout/SSH diagnostics are part of
  # the governed handoff evidence. #759 attempt 4 exposed that command
  # substitution captured stdout only, collapsing a real agent failure into the
  # generic local_openhands_attempt_exhausted reason and hiding what to repair.
  # Stream the remote session live. Command substitution previously buffered all
  # output until SSH exited, making a healthy/running OpenHands session look hung.
  # tee preserves live evidence while a temp file retains the bounded handoff.
  OUTPUT_FILE=$(mktemp)
  trap 'rm -f "$SNAPSHOT" "$OUTPUT_FILE"; cleanup_session' EXIT
  timeout --signal=TERM --kill-after=15s 960s ssh -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=3 "$ENGINEER" bash -s -- "$REPO" "$PROMPT_B64" "$JOB_ID" "$ITERATION" "$RUNTIME_PATH" "$REMOTE_SNAPSHOT" "$MODEL" 2>&1 <<'REMOTE' | tee "$OUTPUT_FILE"
set -euo pipefail
REPO=${1:?repo required}; PROMPT_B64=${2:?prompt required}; JOB_ID=${3:?job id required}; ITERATION=${4:?iteration required}; RUNTIME_PATH=${5:?runtime path required}; SNAPSHOT_REL=${6:?snapshot required}; MODEL=${7:?model required}
SNAPSHOT="$HOME/$SNAPSHOT_REL"
trap 'rm -f "$SNAPSHOT"' EXIT
test -s "$SNAPSHOT"
git -C "$REPO" fetch "$SNAPSHOT" HEAD:refs/remotes/origin/main >/dev/null
HELPER=$(mktemp)
trap 'rm -f "$HELPER" "$SNAPSHOT"' EXIT
git -C "$REPO" show origin/main:governor/scripts/lifeos-remote-agent-builder >"$HELPER"
chmod 700 "$HELPER"
# One local Engineer/OpenHands session owns its engineering loop. Governor does
# not run a second engineering retry loop. The timeout below is only an overall
# safety ceiling; it is deliberately larger than the obsolete 240s cap.
# OpenHands owns the engineering loop. This is an overall safety ceiling, not a
# Governor pseudo-iteration deadline. The old 240s cap killed even the isolated
# #759 filesystem proof before OpenHands emitted its first action (run 35526223801).
# Callers may lower/raise it within the remote helper's validated 60..1200s range.
LIFEOS_AGENT_TIMEOUT_SECONDS="${LIFEOS_AGENT_TIMEOUT_SECONDS:-900}" "$HELPER" "$REPO" "$PROMPT_B64" "$JOB_ID" "$ITERATION" "$RUNTIME_PATH" governor-broker openhands "$MODEL" ""
REMOTE
  )
  RC=${PIPESTATUS[0]}
  set -e
  OUTPUT=$(cat "$OUTPUT_FILE")
  rm -f "$OUTPUT_FILE"
  echo "LOCAL_BUILDER_ATTEMPT_RC=$RC"
checkpoint remote_agent_return
  if (( RC != 0 )); then
    echo "LOCAL_BUILDER_FAILURE_EVIDENCE_BEGIN"
    printf '%s\n' "$OUTPUT" | tail -80
    echo "LOCAL_BUILDER_FAILURE_EVIDENCE_END"
    if grep -q '^HANDOFF_ERROR=' <<<"$OUTPUT"; then
      grep '^HANDOFF_ERROR=' <<<"$OUTPUT" | tail -1
    elif grep -q '^PROVIDER_ERROR=' <<<"$OUTPUT"; then
      grep '^PROVIDER_ERROR=' <<<"$OUTPUT" | tail -1
    else
      echo 'HANDOFF_ERROR=local_builder_failed_without_structured_reason'
    fi
  fi
  if (( RC == 0 )); then
    echo 'AGENT_RESULT=openhands PASS'
    exit 0
  fi
  echo "AGENT_RESULT=openhands FAILED exit=$RC"
  exit "$RC"
