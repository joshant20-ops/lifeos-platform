#!/usr/bin/env python3
"""Deterministic Personal Administration executor.

Governor is intentionally minimal: this script may use governor.ai_broker for
local reasoning, but it does not use Governor autonomous jobs, OpenHands or
cloud AI. Source inspection is restricted to tracked repository files. The AI
is advisory; this executor performs only explicitly allowlisted deterministic
checks.
"""
from __future__ import annotations

import json
import os
import pathlib
import re
import subprocess
import sys
import time

REPO = pathlib.Path(os.getenv("LIFEOS_PLATFORM_REPO", "/home/joshan/lifeos-platform"))
STATE = pathlib.Path(os.getenv(
    "LIFEOS_PA_MISSION_STATE",
    str(pathlib.Path.home() / ".local/state/lifeos-pa-autonomy"),
))
PLAN = STATE / "SCRIPTED_PLAN.json"
RESULT = STATE / "SCRIPTED_RESULT.json"
MAX_FILES = 16
MAX_CHARS_PER_FILE = 12000
MAX_CONTEXT_CHARS = 90000

sys.path.insert(0, str(REPO))
from governor import ai_broker

TERMS = (
    "calendar", "caldav", "ical", "email", "gmail", "imap", "mail",
    "paperless", "document", "personal", "attention", "obligation",
    "evidence", "action", "event", "lifeos_ask", "ask_processor",
)


def run(argv, timeout=60):
    try:
        p = subprocess.run(
            argv, cwd=REPO, text=True, capture_output=True, timeout=timeout,
        )
        return {
            "command": argv,
            "rc": p.returncode,
            "stdout": (p.stdout or "")[-12000:],
            "stderr": (p.stderr or "")[-4000:],
        }
    except subprocess.TimeoutExpired:
        return {"command": argv, "rc": 124, "stdout": "", "stderr": "timeout"}
    except Exception as exc:
        return {"command": argv, "rc": 125, "stdout": "", "stderr": type(exc).__name__}


def local_ai(prompt: str) -> str:
    return ai_broker._ollama(prompt, ai_broker.OLLAMA_MODEL)


def tracked_files():
    p = run(["git", "ls-files"], 30)
    if p["rc"] != 0:
        raise RuntimeError("git_ls_files_failed")
    return p["stdout"].splitlines()


def discover():
    tracked = tracked_files()
    files = {x for x in tracked if any(t in x.lower() for t in TERMS)}

    argv = ["git", "grep", "-I", "-l", "-i"]
    for term in TERMS:
        argv += ["-e", term]
    argv += ["--"]
    grep = run(argv, 45)
    if grep["rc"] in (0, 1):
        files.update(grep["stdout"].splitlines())

    # Prefer implementation/config/test files over docs and historical evidence.
    def score(path: str):
        p = path.lower()
        value = 0
        for term in TERMS:
            if term in p:
                value += 8
        if p.endswith((".py", ".sh", ".yml", ".yaml", ".json")):
            value += 6
        if any(x in p for x in ("script", "governor", "homeassistant", "paperless", "test")):
            value += 3
        if any(x in p for x in ("docs/", "evidence", "archive", "history")):
            value -= 5
        return (-value, path)

    ordered = sorted(files, key=score)
    return {"repo": str(REPO), "candidate_files": ordered[:300]}


def safe_source(path_text: str):
    path = pathlib.PurePosixPath(path_text)
    if path.is_absolute() or ".." in path.parts:
        return None
    full = REPO / path
    try:
        if not full.is_file() or full.is_symlink():
            return None
        data = full.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None
    # Never feed obvious secret material to the model even from the local repo.
    data = re.sub(
        r"(?im)^.*(?:password|secret|token|authorization|api[_-]?key)\s*[=:].*$",
        "[redacted configuration line]",
        data,
    )
    return data[:MAX_CHARS_PER_FILE]


def inspect_candidates(inventory):
    inspected = []
    used = 0
    for path in inventory["candidate_files"]:
        if len(inspected) >= MAX_FILES or used >= MAX_CONTEXT_CHARS:
            break
        data = safe_source(path)
        if not data:
            continue
        remaining = MAX_CONTEXT_CHARS - used
        data = data[:remaining]
        inspected.append({"path": path, "content": data})
        used += len(data)
    return inspected


def parse_json(raw: str):
    text = raw.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```$", "", text)
    try:
        value = json.loads(text)
        return value if isinstance(value, dict) else {"status": "INVALID_PLAN_TYPE", "raw": text[:8000]}
    except Exception:
        start, end = text.find("{"), text.rfind("}")
        if start >= 0 and end > start:
            try:
                value = json.loads(text[start:end + 1])
                if isinstance(value, dict):
                    return value
            except Exception:
                pass
        return {"status": "PLAN_PARSE_FAILED", "raw": text[:8000]}


def make_plan(inventory, inspected):
    source_context = [{"path": x["path"], "content": x["content"]} for x in inspected]
    prompt = """You are the LOCAL LifeOS Personal Administration engineering planner.

Goal: integrate existing Calendar + Email + Paperless capabilities through the
existing shared event/obligation/action/evidence model and PA attention surface.

Architecture constraints:
- Governor autonomy/OpenHands/cloud AI are disabled by design.
- Deterministic Pi-side scripts do execution; local AI is advisory.
- Reuse existing working services and code. OTS/native first.
- Paperless remains document authority.
- Do not request or expose live private Calendar/Email/Paperless contents.
- Do not invent services or claim files exist unless present below.
- Do not suggest arbitrary shell/root commands.

Return ONE JSON object only with exactly these top-level keys:
status, findings, target_files, next_action, deterministic_checks, rationale

status must be READY or BLOCKED.
target_files must contain only repository paths present below.
next_action must be a bounded engineering action based on inspected code, not
an instruction to merely inspect another file.
deterministic_checks must be a list of safe read-only/test checks.

Candidate paths:
""" + json.dumps(inventory["candidate_files"][:120]) + "\n\nInspected repository source:\n" + json.dumps(source_context)
    return parse_json(local_ai(prompt))


def normalize_plan(plan, inventory):
    allowed = set(inventory["candidate_files"])
    targets = plan.get("target_files", [])
    if not isinstance(targets, list):
        targets = []
    plan["target_files"] = [x for x in targets if isinstance(x, str) and x in allowed][:12]
    if plan.get("status") not in {"READY", "BLOCKED"}:
        plan["status"] = "BLOCKED"
    for key in ("findings", "deterministic_checks"):
        if not isinstance(plan.get(key), list):
            plan[key] = []
    if not isinstance(plan.get("next_action"), str):
        plan["next_action"] = ""
    if not isinstance(plan.get("rationale"), str):
        plan["rationale"] = ""
    return plan


def deterministic_checks(plan):
    checks = []
    checks.append(run(["git", "diff", "--check"], 30))
    checks.append(run(["python3", "-m", "compileall", "-q", "governor"], 90))

    # Compile only AI-selected Python files; never execute selected source.
    py_targets = [x for x in plan.get("target_files", []) if x.endswith(".py")]
    for path in py_targets[:8]:
        checks.append(run(["python3", "-m", "py_compile", path], 30))
    return checks


def main():
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)

    print("STAGE=scripted_inventory", flush=True)
    try:
        inventory = discover()
    except Exception as exc:
        print(f"SCRIPTED_EXECUTION=BLOCKED reason={type(exc).__name__}")
        return 20
    print(f"CANDIDATE_FILES={len(inventory['candidate_files'])}", flush=True)
    if not inventory["candidate_files"]:
        print("SCRIPTED_EXECUTION=BLOCKED reason=no_candidates")
        return 20

    print("STAGE=automatic_source_inspection", flush=True)
    inspected = inspect_candidates(inventory)
    print(f"INSPECTED_FILES={len(inspected)}", flush=True)
    if not inspected:
        print("SCRIPTED_EXECUTION=BLOCKED reason=no_readable_candidates")
        return 20

    print("STAGE=local_ai_plan", flush=True)
    try:
        plan = normalize_plan(make_plan(inventory, inspected), inventory)
    except Exception as exc:
        plan = {"status": "BLOCKED", "findings": [], "target_files": [],
                "next_action": "", "deterministic_checks": [],
                "rationale": f"local_ai_failed:{type(exc).__name__}"}

    PLAN.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print("STAGE=deterministic_verification", flush=True)
    checks = deterministic_checks(plan)
    failed = [x for x in checks if x["rc"] != 0]

    result = {
        "timestamp": int(time.time()),
        "inventory": {"repo": inventory["repo"],
                      "candidate_files": inventory["candidate_files"]},
        "inspected_files": [x["path"] for x in inspected],
        "plan": plan,
        "verification": checks,
    }
    RESULT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print("SCRIPTED_PLAN=" + str(PLAN))
    print("SCRIPTED_RESULT=" + str(RESULT))
    print("PLAN_STATUS=" + plan.get("status", "BLOCKED"))
    if plan.get("next_action"):
        print("NEXT_ACTION=" + plan["next_action"].replace("\n", " ")[:500])

    if failed or plan.get("status") != "READY":
        print("SCRIPTED_EXECUTION=BLOCKED")
        return 20
    print("SCRIPTED_EXECUTION=PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
