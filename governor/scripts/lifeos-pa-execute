#!/usr/bin/env python3
"""Deterministic Personal Administration executor.

Governor is intentionally minimal. Local Ollama is the normal reasoning path.
If that path fails, one bounded Codex CLI repair attempt may diagnose/fix the
minimal Tower/Ollama/broker path, after which the executor re-verifies and
continues automatically. Governor autonomous jobs, OpenHands and cloud routing
remain disabled.
"""
from __future__ import annotations

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

REPO = pathlib.Path(os.getenv("LIFEOS_PLATFORM_REPO", "/home/joshan/lifeos-platform"))
STATE = pathlib.Path(os.getenv(
    "LIFEOS_PA_MISSION_STATE",
    str(pathlib.Path.home() / ".local/state/lifeos-pa-autonomy"),
))
PLAN = STATE / "SCRIPTED_PLAN.json"
RESULT = STATE / "SCRIPTED_RESULT.json"
CODEX_LOG = STATE / "CODEX_REPAIR.log"
MAX_FILES = 32
MAX_CHARS_PER_FILE = 12000
MAX_CONTEXT_CHARS = 180000
CHUNK_FILES = 6
CHUNK_FILE_CHARS = 3000
CODEX_TIMEOUT = int(os.getenv("LIFEOS_PA_CODEX_TIMEOUT", "900"))

sys.path.insert(0, str(REPO))
from governor import ai_broker

TERMS = (
    "calendar", "caldav", "ical", "email", "gmail", "imap", "mail",
    "paperless", "document", "personal", "attention", "obligation",
    "evidence", "action", "event", "lifeos_ask", "ask_processor",
)
DOMAIN_TERMS = {
    "calendar": ("calendar", "caldav", "ical"),
    "email": ("email", "gmail", "imap", "mail"),
    "paperless": ("paperless", "document", "evidence"),
    "shared": ("attention", "obligation", "action", "event", "lifeos_ask", "ask_processor"),
}


def run(argv, timeout=60):
    try:
        p = subprocess.run(argv, cwd=REPO, text=True, capture_output=True, timeout=timeout)
        return {
            "command": argv,
            "rc": p.returncode,
            "stdout": (p.stdout or "")[-12000:],
            "stderr": (p.stderr or "")[-4000:],
        }
    except subprocess.TimeoutExpired:
        return {"command": argv, "rc": 124, "stdout": "", "stderr": "timeout"}
    except Exception as exc:
        return {"command": argv, "rc": 125, "stdout": "", "stderr": type(exc).__name__}


def local_ai(prompt: str) -> str:
    return ai_broker._ollama(prompt, ai_broker.OLLAMA_MODEL)


def broker_probe():
    try:
        reply = local_ai("Reply with exactly: LOCAL_AI_OK")
        return {"ok": "LOCAL_AI_OK" in reply, "reply": reply[-300:]}
    except Exception as exc:
        return {"ok": False, "error": type(exc).__name__}


def codex_repair(reason: str):
    """One bounded repair attempt; no destructive git and no autonomy expansion."""
    codex = shutil.which("codex")
    if not codex:
        return {"attempted": False, "ok": False, "reason": "codex_not_installed"}

    status = run(["git", "status", "--porcelain", "--untracked-files=all"], 30)
    if status["rc"] != 0 or status["stdout"].strip():
        return {"attempted": False, "ok": False, "reason": "worktree_not_clean_before_codex"}

    prompt = f"""Repair one bounded LifeOS infrastructure failure in this repository.

Observed failure: {reason}

Current intended architecture:
- Governor autonomous jobs are disabled by design.
- Do NOT enable OpenHands, backlog/autonomous-agent jobs, or cloud-provider routing.
- The only Governor capability to repair is: Tower wake -> local Ollama -> broker reply -> lease release/shutdown.
- Normal model endpoint is the existing governor.ai_broker local Ollama path.
- Preserve Watchman/root protections.
- Do not use or print private Calendar, Email, Paperless, finance, secrets, tokens, credentials or household content.
- Do not use git reset --hard, git clean, force push, or destructive recovery.
- Do not commit or push changes.
- Prefer existing scripts/services/configuration over new machinery.

Work autonomously inside the repository and with safe non-secret runtime checks.
Reproduce the minimal broker failure first. Find the shared root cause and make
the smallest safe repair you can. Run relevant deterministic tests and finish
only after re-running this exact acceptance probe successfully:

python3 -c "import sys; sys.path.insert(0, '/home/joshan/lifeos-platform'); from governor import ai_broker; r=ai_broker._ollama('Reply with exactly: LOCAL_AI_OK', ai_broker.OLLAMA_MODEL); print(r.strip()); raise SystemExit(0 if 'LOCAL_AI_OK' in r else 9)"

If a genuine human boundary blocks repair, leave the repository unchanged and
state the boundary clearly. Do not broaden scope into Personal Administration.
"""
    print("STAGE=codex_self_repair", flush=True)
    result = run([codex, "exec", "--full-auto", prompt], CODEX_TIMEOUT)
    CODEX_LOG.write_text(
        "STDOUT\n" + result["stdout"] + "\n\nSTDERR\n" + result["stderr"] + "\n",
        encoding="utf-8",
    )

    diff_check = run(["git", "diff", "--check"], 30)
    compile_check = run(["python3", "-m", "compileall", "-q", "governor"], 120)
    probe = broker_probe()
    dirty = run(["git", "status", "--porcelain", "--untracked-files=all"], 30)
    changed = bool(dirty["stdout"].strip())
    ok = result["rc"] == 0 and diff_check["rc"] == 0 and compile_check["rc"] == 0 and probe["ok"]
    return {
        "attempted": True,
        "ok": ok,
        "codex_rc": result["rc"],
        "diff_check_rc": diff_check["rc"],
        "compile_rc": compile_check["rc"],
        "broker_probe": probe,
        "worktree_changed": changed,
        "log": str(CODEX_LOG),
    }


def tracked_files():
    p = run(["git", "ls-files"], 30)
    if p["rc"] != 0:
        raise RuntimeError("git_ls_files_failed")
    return p["stdout"].splitlines()


def discover():
    tracked = tracked_files()
    files = {x for x in tracked if any(t in x.lower() for t in TERMS)}
    argv = ["git", "grep", "-I", "-l", "-i"]
    for term in TERMS:
        argv += ["-e", term]
    argv += ["--"]
    grep = run(argv, 45)
    if grep["rc"] in (0, 1):
        files.update(grep["stdout"].splitlines())

    def score(path: str):
        p = path.lower()
        value = sum(8 for term in TERMS if term in p)
        if p.endswith((".py", ".sh", ".yml", ".yaml", ".json")):
            value += 6
        if any(x in p for x in ("script", "governor", "homeassistant", "paperless", "test")):
            value += 3
        if any(x in p for x in ("docs/", "evidence", "archive", "history")):
            value -= 5
        return (-value, path)

    return {"repo": str(REPO), "candidate_files": sorted(files, key=score)[:300]}


def safe_source(path_text: str):
    path = pathlib.PurePosixPath(path_text)
    if path.is_absolute() or ".." in path.parts:
        return None
    full = REPO / path
    try:
        if not full.is_file() or full.is_symlink():
            return None
        data = full.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None
    data = re.sub(
        r"(?im)^.*(?:password|secret|token|authorization|api[_-]?key)\s*[=:].*$",
        "[redacted configuration line]", data,
    )
    return data[:MAX_CHARS_PER_FILE]


def inspect_candidates(inventory):
    candidates = inventory["candidate_files"]
    selected = []
    for terms in DOMAIN_TERMS.values():
        for path in candidates:
            p = path.lower()
            if path not in selected and any(term in p for term in terms):
                selected.append(path)
                break
    for path in candidates:
        if path not in selected:
            selected.append(path)
        if len(selected) >= MAX_FILES:
            break

    inspected, used = [], 0
    for path in selected:
        if len(inspected) >= MAX_FILES or used >= MAX_CONTEXT_CHARS:
            break
        data = safe_source(path)
        if not data:
            continue
        data = data[:MAX_CONTEXT_CHARS - used]
        inspected.append({"path": path, "content": data})
        used += len(data)
    return {item["path"]: item["content"] for item in inspected}


def parse_json(raw: str):
    text = raw.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```$", "", text)
    try:
        value = json.loads(text)
        return value if isinstance(value, dict) else {"status": "INVALID_PLAN_TYPE", "raw": text[:8000]}
    except Exception:
        start, end = text.find("{"), text.rfind("}")
        if start >= 0 and end > start:
            try:
                value = json.loads(text[start:end + 1])
                if isinstance(value, dict):
                    return value
            except Exception:
                pass
        return {"status": "PLAN_PARSE_FAILED", "raw": text[:8000]}


def make_plan(candidates, inspected):
    import json

    def parse_json(raw):
        raw = str(raw).strip()
        if raw.startswith("```"):
            lines = raw.splitlines()[1:]
            if lines and lines[-1].strip().startswith("```"):
                lines = lines[:-1]
            raw = "\n".join(lines).strip()
        try:
            return json.loads(raw)
        except Exception:
            a = raw.find("{")
            b = raw.rfind("}")
            if a < 0 or b <= a:
                raise
            return json.loads(raw[a:b+1])

    paths = list(inspected.keys())
    summaries = []

    for offset in range(0, len(paths), CHUNK_FILES):
        batch = paths[offset:offset + CHUNK_FILES]
        blocks = []

        for rel in batch:
            text = inspected.get(rel, "")
            complete = len(text) < MAX_CHARS_PER_FILE
            blocks.append(
                f"FILE: {rel}\n"
                f"EXCERPT_COMPLETE={str(complete).lower()}\n"
                f"{text[:CHUNK_FILE_CHARS]}"
            )

        prompt = """Inspect ONLY these LifeOS Personal Administration source excerpts.

Return JSON only:
{
  "capabilities": [],
  "proven_gaps": [],
  "important_files": [],
  "risks": []
}

Rules:
- excerpts may be intentionally truncated
- NEVER infer a missing EOF, missing function, broken syntax, or incomplete file solely because an excerpt ends
- only report a defect when directly proven by supplied text
- distinguish proven gaps from uncertainty
- do not execute or mutate anything

SOURCE:
""" + "\n\n".join(blocks)

        raw = local_ai(prompt)
        summaries.append(parse_json(raw))
        print(f"PLAN_BATCH_{offset // CHUNK_FILES + 1}=PASS")

    prompt = """Plan ONE bounded next engineering step for LifeOS Personal Administration.

Return JSON only:
{
  "status": "READY|BLOCKED",
  "findings": [],
  "target_files": [],
  "next_action": "",
  "deterministic_checks": [],
  "rationale": ""
}

Rules:
- use ONLY the chunk summaries supplied below
- excerpts used to create summaries may have been intentionally truncated
- NEVER infer missing EOF/file corruption from truncation
- prefer existing working capabilities
- private Calendar/Email/Paperless content stays local
- no new service unless a proven gap requires it
- choose ONE concrete Personal Administration engineering step
- BLOCKED only for a concrete dependency, human authorization, or unsafe boundary
- uncertainty alone is not BLOCKED

SUMMARIES:
""" + json.dumps(summaries)

    return parse_json(local_ai(prompt))

def normalize_plan(plan, inventory):
    allowed = set(inventory["candidate_files"])
    targets = plan.get("target_files", [])
    if not isinstance(targets, list):
        targets = []
    plan["target_files"] = [x for x in targets if isinstance(x, str) and x in allowed][:12]
    if plan.get("status") not in {"READY", "BLOCKED"}:
        plan["status"] = "BLOCKED"
    for key in ("findings", "deterministic_checks"):
        if not isinstance(plan.get(key), list):
            plan[key] = []
    if not isinstance(plan.get("next_action"), str):
        plan["next_action"] = ""
    if not isinstance(plan.get("rationale"), str):
        plan["rationale"] = ""
    return plan


def deterministic_checks(plan):
    checks = [
        run(["git", "diff", "--check"], 30),
        run(["python3", "-m", "compileall", "-q", "governor"], 90),
    ]
    for path in [x for x in plan.get("target_files", []) if x.endswith(".py")][:8]:
        checks.append(run(["python3", "-m", "py_compile", path], 30))
    return checks


def main():
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)

    print("STAGE=scripted_inventory", flush=True)
    try:
        inventory = discover()
    except Exception as exc:
        print(f"SCRIPTED_EXECUTION=BLOCKED reason={type(exc).__name__}")
        return 20
    print(f"CANDIDATE_FILES={len(inventory['candidate_files'])}", flush=True)
    if not inventory["candidate_files"]:
        print("SCRIPTED_EXECUTION=BLOCKED reason=no_candidates")
        return 20

    print("STAGE=automatic_source_inspection", flush=True)
    inspected = inspect_candidates(inventory)
    print(f"INSPECTED_FILES={len(inspected)}", flush=True)
    if not inspected:
        print("SCRIPTED_EXECUTION=BLOCKED reason=no_readable_candidates")
        return 20

    print("STAGE=local_ai_plan", flush=True)
    repair = None
    try:
        plan = normalize_plan(make_plan(inventory, inspected), inventory)
    except Exception as exc:
        reason = f"local_ai_failed:{type(exc).__name__}"
        repair = codex_repair(reason)
        if repair.get("ok"):
            print("CODEX_REPAIR=PASS", flush=True)
            try:
                plan = normalize_plan(make_plan(inventory, inspected), inventory)
            except Exception as retry_exc:
                plan = {"status": "BLOCKED", "findings": [], "target_files": [],
                        "next_action": "", "deterministic_checks": [],
                        "rationale": f"local_ai_retry_failed:{type(retry_exc).__name__}"}
        else:
            print("CODEX_REPAIR=BLOCKED", flush=True)
            plan = {"status": "BLOCKED", "findings": [], "target_files": [],
                    "next_action": "", "deterministic_checks": [],
                    "rationale": reason + ";codex_repair_failed"}

    PLAN.write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print("STAGE=deterministic_verification", flush=True)
    checks = deterministic_checks(plan)
    failed = [x for x in checks if x["rc"] != 0]
    dirty = run(["git", "status", "--porcelain", "--untracked-files=all"], 30)

    result = {
        "timestamp": int(time.time()),
        "inventory": {"repo": inventory["repo"], "candidate_files": inventory["candidate_files"]},
        "inspected_files": list(inspected),
        "plan": plan,
        "codex_repair": repair,
        "verification": checks,
        "worktree_dirty": bool(dirty["stdout"].strip()),
    }
    RESULT.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print("SCRIPTED_PLAN=" + str(PLAN))
    print("SCRIPTED_RESULT=" + str(RESULT))
    print("PLAN_STATUS=" + plan.get("status", "BLOCKED"))
    if repair:
        print("CODEX_REPAIR_LOG=" + str(CODEX_LOG))
        print("CODEX_WORKTREE_CHANGED=" + str(bool(repair.get("worktree_changed"))).lower())
    if plan.get("next_action"):
        print("NEXT_ACTION=" + plan["next_action"].replace("\n", " ")[:500])
    if plan.get("rationale"):
        print("PLAN_RATIONALE=" + plan["rationale"].replace("\n", " ")[:500])

    # Never silently declare mission PASS with an uncommitted Codex patch.
    if dirty["stdout"].strip():
        print("SCRIPTED_EXECUTION=BLOCKED reason=codex_patch_requires_review")
        return 20
    if failed or plan.get("status") != "READY":
        print("SCRIPTED_EXECUTION=BLOCKED")
        return 20
    print("SCRIPTED_EXECUTION=PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
