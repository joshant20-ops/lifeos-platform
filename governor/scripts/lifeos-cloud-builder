#!/usr/bin/env bash
set -euo pipefail

REQUEST=${1:?request required}
ITERATION=${2:?iteration required}
FEEDBACK=${3:-}
PRIVACY=${LIFEOS_JOB_PRIVACY:-normal}
JOB_ID=${LIFEOS_JOB_ID:-unknown}
TASK_CLASS=${LIFEOS_JOB_TASK_CLASS:-normal}
ENGINEER=${LIFEOS_ENGINEER_SSH:-Engineer}
REPO=${LIFEOS_ENGINEER_REPO:-/home/joshan/workspace/lifeos-platform}

if [[ "$PRIVACY" == "local-only" ]]; then
  echo "RESULT=BLOCKED"
  echo "REASON=cloud_builder_forbidden_for_local_only_job"
  exit 42
fi

case "$TASK_CLASS" in
  normal|substantial|review|escalation) ;;
  *) TASK_CLASS=normal ;;
esac

RUNTIME_PATH="governor/runtime_jobs/${JOB_ID}.sh"

SAFE_REQUEST=$(printf '%s' "$REQUEST" | python3 -c '
import re,sys
s=sys.stdin.read()
s=re.sub(r"(?is)-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----", "[REDACTED_PRIVATE_KEY]", s)
s=re.sub(r"(?i)\b(api[_ -]?key|access[_ -]?token|bearer|password|secret)\s*[:=]\s*[^\s,;]+", lambda m: m.group(1)+"=[REDACTED]", s)
print(s, end="")
')
if [[ "$SAFE_REQUEST" != "$REQUEST" ]]; then
  echo "CLOUD_REQUEST_REDACTED=YES"
fi

PROMPT=$(cat <<EOF
You are an engineering builder for LifeOS autonomous job $JOB_ID.
Work toward the user's original goal until this iteration has produced a concrete, testable improvement.

ARCHITECTURE AND SAFETY:
- Pi5/Docker is the central controller, canonical Git writer, runtime executor, AI policy authority, and cloud credential owner.
- OpenHands runs on Engineer/Z97 only when agentic execution is required.
- OpenHands receives only a Pi5 Governor broker capability; it never receives provider API keys.
- Do not require the user to run commands on secondary machines.
- Do NOT commit, push, fetch, clone, or otherwise depend on GitHub/network access from inside the coding agent. Pi5 owns Git publication.
- If runtime inspection/change is required on Pi5, Engineer, TowerPC, Home Assistant, or another LAN host, create exactly one Pi5 launcher at: $RUNTIME_PATH
- That launcher must start with #!/usr/bin/env bash, be non-interactive, timeout-aware, and may SSH to secondary machines itself.
- Never put secrets or private Paperless/document content in GitHub, prompts, logs, patches, or runtime launchers.
- Cloud providers are forbidden from processing local-only/private jobs.
- Scope tests to the user's requested outcome. Unrelated pre-existing repository failures may be reported but MUST NOT block a scoped job if the requested outcome can still be verified safely.
- The local verifier, not you, decides final completion.

REPOSITORY WORK:
- You are working in a clean disposable worktree based on origin/main.
- Make any repository changes needed for this iteration and leave them in the worktree; the wrapper will package them for Pi5.
- If you create $RUNTIME_PATH, make it safe and self-verifying: it should print clear PASS/FAIL evidence for the requested outcome.
- Run focused tests for files you changed.
- Do not merely explain what should be done: perform all repository engineering work available to you.

USER GOAL:
$SAFE_REQUEST

ITERATION: $ITERATION

LOCAL VERIFIER FEEDBACK:
${FEEDBACK:-none yet}

FINAL OUTPUT CONTRACT:
Print these lines at the end:
RESULT=PASS|RETRY|BLOCKED
TESTS=<concise result>
NEXT_RUNTIME_CHECK=<concise check or none>
EOF
)
PROMPT_B64=$(printf '%s' "$PROMPT" | base64 -w0)

DISCOVERY=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$ENGINEER" bash -s <<'REMOTE'
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
if command -v openhands >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/openhands" ]]; then
  echo 'OPENHANDS=present'
else
  echo 'OPENHANDS=absent'
fi
if command -v codex >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/codex" ]]; then
  echo 'CODEX=present'
else
  echo 'CODEX=absent'
fi
cfg="$HOME/.config/lifeos/governor-broker.env"
if [[ -f "$cfg" && ! -L "$cfg" && "$(stat -c '%a' "$cfg")" == 600 ]] \
   && grep -q '^LIFEOS_GOVERNOR_BROKER_URL=' "$cfg" \
   && grep -q '^LIFEOS_GOVERNOR_BROKER_TOKEN=' "$cfg"; then
  echo 'GOVERNOR_BROKER=present'
else
  echo 'GOVERNOR_BROKER=absent'
fi
REMOTE
)
printf '%s\n' "$DISCOVERY"

OPENHANDS=$(sed -n 's/^OPENHANDS=//p' <<<"$DISCOVERY" | tail -1)
CODEX=$(sed -n 's/^CODEX=//p' <<<"$DISCOVERY" | tail -1)
GOVERNOR_BROKER=$(sed -n 's/^GOVERNOR_BROKER=//p' <<<"$DISCOVERY" | tail -1)

AGENTS=()
if [[ "$TASK_CLASS" != "escalation" && "$OPENHANDS" == present && "$GOVERNOR_BROKER" == present ]]; then
  AGENTS+=("governor-broker|openhands|openai/lifeos-${TASK_CLASS}")
fi
if [[ "$CODEX" == present ]]; then
  AGENTS+=("codex|codex|")
fi

if (( ${#AGENTS[@]} == 0 )); then
  echo "RESULT=BLOCKED"
  echo "REASON=no_eligible_engineering_agent"
  exit 43
fi

MAX_ATTEMPTS=2
for spec in "${AGENTS[@]}"; do
  IFS='|' read -r PROVIDER ADAPTER MODEL <<<"$spec"
  for ((attempt=1; attempt<=MAX_ATTEMPTS; attempt++)); do
    echo "AGENT_ATTEMPT=$ADAPTER provider=$PROVIDER attempt=$attempt"
    set +e
    OUTPUT=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$ENGINEER" bash -s -- \
      "$REPO" "$PROMPT_B64" "$JOB_ID" "$ITERATION" "$RUNTIME_PATH" \
      "$PROVIDER" "$ADAPTER" "$MODEL" "" <<'REMOTE'
set -euo pipefail
REPO=$1; PROMPT_B64=$2; JOB_ID=$3; ITERATION=$4; RUNTIME_PATH=$5
PROVIDER=$6; ADAPTER=$7; MODEL=$8; CREDENTIALS=$9
git -C "$REPO" fetch origin main >/dev/null
HELPER=$(mktemp)
trap 'rm -f "$HELPER"' EXIT
git -C "$REPO" show origin/main:governor/scripts/lifeos-remote-agent-builder >"$HELPER"
chmod 700 "$HELPER"
"$HELPER" \
  "$REPO" "$PROMPT_B64" "$JOB_ID" "$ITERATION" "$RUNTIME_PATH" \
  "$PROVIDER" "$ADAPTER" "$MODEL" "$CREDENTIALS"
REMOTE
    )
    RC=$?
    set -e
    printf '%s\n' "$OUTPUT"
    if (( RC == 0 )); then
      echo "AGENT_RESULT=$ADAPTER PASS"
      exit 0
    fi
    echo "AGENT_RESULT=$ADAPTER RETRY exit=$RC"
  done
done

echo "RESULT=RETRY"
echo "REASON=eligible_engineering_agents_exhausted"
exit 21
