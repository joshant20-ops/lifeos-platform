#!/usr/bin/env bash
set -euo pipefail

REQUEST=${1:?request required}
ITERATION=${2:?iteration required}
FEEDBACK=${3:-}
PRIVACY=${LIFEOS_JOB_PRIVACY:-normal}
JOB_ID=${LIFEOS_JOB_ID:-unknown}
ENGINEER=${LIFEOS_ENGINEER_SSH:-Engineer}
REPO=${LIFEOS_ENGINEER_REPO:-/home/joshan/workspace/lifeos-platform}

if [[ "$PRIVACY" == "local-only" ]]; then
  echo "RESULT=BLOCKED"
  echo "REASON=cloud_builder_forbidden_for_local_only_job"
  exit 42
fi

RUNTIME_PATH="governor/runtime_jobs/${JOB_ID}.sh"

PROMPT=$(cat <<EOF
You are the cloud engineering builder for LifeOS autonomous job $JOB_ID.
Work toward the user's original goal until this iteration has produced a concrete, testable improvement.

ARCHITECTURE AND SAFETY:
- Pi5/Docker is the central controller, canonical Git writer, and runtime executor.
- Do not require the user to run commands on secondary machines.
- Do NOT commit, push, fetch, clone, or otherwise depend on GitHub/network access from inside Codex. Pi5 owns Git publication.
- If runtime inspection/change is required on Pi5, Engineer, TowerPC, Home Assistant, or another LAN host, create exactly one Pi5 launcher at: $RUNTIME_PATH
- That launcher must start with #!/usr/bin/env bash, be non-interactive, timeout-aware, and may SSH to secondary machines itself.
- Never put secrets or private Paperless/document content in GitHub, prompts, logs, patches, or runtime launchers.
- This cloud builder is forbidden from processing private document contents.
- Scope tests to the user's requested outcome. Unrelated pre-existing repository failures may be reported but MUST NOT block a scoped job if the requested outcome can still be verified safely.
- The local verifier, not you, decides final completion.

REPOSITORY WORK:
- You are working in a clean disposable worktree based on origin/main.
- Make any repository changes needed for this iteration and leave them in the worktree; the wrapper will package them for Pi5.
- If you create $RUNTIME_PATH, make it safe and self-verifying: it should print clear PASS/FAIL evidence for the requested outcome.
- Run focused tests for files you changed.
- Do not merely explain what should be done: perform all repository engineering work available to you.

USER GOAL:
$REQUEST

ITERATION: $ITERATION

LOCAL VERIFIER FEEDBACK:
${FEEDBACK:-none yet}

FINAL OUTPUT CONTRACT:
Print these lines at the end:
RESULT=PASS|RETRY|BLOCKED
TESTS=<concise result>
NEXT_RUNTIME_CHECK=<concise check or none>
EOF
)

PROMPT_B64=$(printf '%s' "$PROMPT" | base64 -w0)

ssh -o BatchMode=yes -o ConnectTimeout=8 "$ENGINEER" \
  bash -s -- "$REPO" "$PROMPT_B64" "$JOB_ID" "$ITERATION" "$RUNTIME_PATH" <<'REMOTE'
set -euo pipefail
REPO=$1
PROMPT_B64=$2
JOB_ID=$3
ITERATION=$4
RUNTIME_PATH=$5
PROMPT=$(printf '%s' "$PROMPT_B64" | base64 -d)

CODEX="${LIFEOS_CODEX_BIN:-$HOME/.local/bin/codex}"
if [[ ! -x "$CODEX" ]]; then
  CODEX="$(command -v codex 2>/dev/null || true)"
fi
if [[ -z "$CODEX" || ! -x "$CODEX" ]]; then
  echo "RESULT=BLOCKED"
  echo "REASON=codex_missing_on_engineer"
  exit 50
fi

echo "CODEX_BIN=$CODEX"

cd "$REPO"
git fetch origin main

WORKROOT="$HOME/.local/share/lifeos-agent/worktrees"
WORKTREE="$WORKROOT/${JOB_ID}-${ITERATION}"
mkdir -p "$WORKROOT"

git worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true
rm -rf "$WORKTREE"
git worktree add --detach "$WORKTREE" origin/main >/dev/null

cleanup() {
  git -C "$REPO" worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true
}
trap cleanup EXIT

cd "$WORKTREE"
BASE=$(git rev-parse HEAD)
echo "WORKTREE_BASE=$BASE"

HELP="$("$CODEX" exec --help 2>&1 || true)"
if grep -q -- '--full-auto' <<<"$HELP"; then
  "$CODEX" exec --full-auto "$PROMPT" </dev/null
elif "$CODEX" --help 2>&1 | grep -q -- '--full-auto'; then
  "$CODEX" --full-auto exec "$PROMPT" </dev/null
else
  "$CODEX" exec "$PROMPT" </dev/null
fi

# Codex may stage files, leave them unstaged, create untracked files, or even
# make local commits. Stage the full resulting tree state, then export the
# complete delta against the immutable starting point. `git diff` alone would
# omit new untracked files such as per-job runtime launchers.
git reset --mixed "$BASE" >/dev/null 2>&1 || true
git add -A
PATCH_FILE=$(mktemp)
git diff --cached --binary "$BASE" -- . >"$PATCH_FILE"
PATCH_BYTES=$(wc -c <"$PATCH_FILE")
if (( PATCH_BYTES > 1048576 )); then
  echo "HANDOFF_ERROR=patch_exceeds_1MiB"
  exit 61
fi

echo "HANDOFF_BASE=$BASE"
echo "HANDOFF_PATCH_BYTES=$PATCH_BYTES"
if (( PATCH_BYTES > 0 )); then
  echo "HANDOFF_PATCH_B64=$(base64 -w0 <"$PATCH_FILE")"
fi
rm -f "$PATCH_FILE"

if [[ -f "$RUNTIME_PATH" ]]; then
  RUNTIME_BYTES=$(wc -c <"$RUNTIME_PATH")
  if (( RUNTIME_BYTES > 65536 )); then
    echo "HANDOFF_ERROR=runtime_script_exceeds_64KiB"
    exit 62
  fi
  echo "RUN_SCRIPT=$RUNTIME_PATH"
  echo "HANDOFF_RUNTIME_B64=$(base64 -w0 <"$RUNTIME_PATH")"
fi

echo "WORKTREE_STATUS_BEGIN"
git status --short
echo "WORKTREE_STATUS_END"
REMOTE
