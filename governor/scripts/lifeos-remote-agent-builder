#!/usr/bin/env bash
set -euo pipefail

REPO=${1:?repo required}
PROMPT_B64=${2:?prompt required}
JOB_ID=${3:?job id required}
ITERATION=${4:?iteration required}
RUNTIME_PATH=${5:?runtime path required}
PROVIDER=${6:?provider required}
ADAPTER=${7:?adapter required}
MODEL=${8:-}
CREDENTIAL_NAMES=${9:-}
AGENT_TIMEOUT_SECONDS=${LIFEOS_AGENT_TIMEOUT_SECONDS:-600}
[[ "$AGENT_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] && (( AGENT_TIMEOUT_SECONDS >= 60 && AGENT_TIMEOUT_SECONDS <= 1200 )) || { echo "PROVIDER_ERROR=invalid_agent_timeout"; exit 53; }
SECRET_FILE=${LIFEOS_PROVIDER_SECRETS_FILE:-$HOME/.config/lifeos/provider-secrets.env}
BROKER_CONFIG=${LIFEOS_GOVERNOR_BROKER_CONFIG:-$HOME/.config/lifeos/governor-broker.env}

stage() { printf 'OPENHANDS_PIPELINE_STAGE=%s ts=%s\n' "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; }
stage remote_builder_start
PROMPT=$(printf '%s' "$PROMPT_B64" | base64 -d)
stage prompt_decoded

load_selected_credentials() {
  [[ -n "$CREDENTIAL_NAMES" ]] || return 0
  [[ -f "$SECRET_FILE" && ! -L "$SECRET_FILE" ]] || { echo "PROVIDER_ERROR=credential_file_missing"; return 20; }
  mode=$(stat -c '%a' "$SECRET_FILE")
  [[ "$mode" == 600 ]] || { echo "PROVIDER_ERROR=credential_file_mode_${mode}"; return 20; }
  IFS=',' read -r -a requested <<<"$CREDENTIAL_NAMES"
  for name in "${requested[@]}"; do
    [[ "$name" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]] || { echo "PROVIDER_ERROR=invalid_credential_name"; return 20; }
    value=$(python3 - "$SECRET_FILE" "$name" <<'PY'
import pathlib, sys
path=pathlib.Path(sys.argv[1]); wanted=sys.argv[2]
for raw in path.read_text(encoding='utf-8').splitlines():
    line=raw.strip()
    if not line or line.startswith('#'): continue
    if line.startswith('export '): line=line[7:].lstrip()
    key, sep, value=line.partition('=')
    if sep and key == wanted:
        print(value, end=''); raise SystemExit(0)
raise SystemExit(3)
PY
) || { echo "PROVIDER_ERROR=credential_required name=$name"; return 20; }
    [[ -n "$value" ]] || { echo "PROVIDER_ERROR=credential_required name=$name"; return 20; }
    export "$name=$value"
  done
  if (( ${#requested[@]} == 1 )); then export LLM_API_KEY="${!requested[0]}"; fi
}

load_governor_broker() {
  [[ -f "$BROKER_CONFIG" && ! -L "$BROKER_CONFIG" ]] || { echo "PROVIDER_ERROR=governor_broker_config_missing"; return 20; }
  mode=$(stat -c '%a' "$BROKER_CONFIG")
  [[ "$mode" == 600 ]] || { echo "PROVIDER_ERROR=governor_broker_config_mode_${mode}"; return 20; }
  local url token
  url=$(sed -n 's/^LIFEOS_GOVERNOR_BROKER_URL=//p' "$BROKER_CONFIG" | tail -1)
  token=$(sed -n 's/^LIFEOS_GOVERNOR_BROKER_TOKEN=//p' "$BROKER_CONFIG" | tail -1)
  [[ "$url" == http://* || "$url" == https://* ]] || { echo "PROVIDER_ERROR=governor_broker_url_missing"; return 20; }
  [[ -n "$token" ]] || { echo "PROVIDER_ERROR=governor_broker_token_missing"; return 20; }
  export LLM_BASE_URL="${url%/}"
  export LLM_API_KEY="$token"
  export LLM_MODEL="${MODEL:-openai/lifeos-normal}"
  export LIFEOS_PROVIDER="governor-broker"
}

resolve_agent() {
  case "$ADAPTER" in
    codex)
      AGENT="${LIFEOS_CODEX_BIN:-$HOME/.local/bin/codex}"; [[ -x "$AGENT" ]] || AGENT=$(command -v codex 2>/dev/null || true)
      [[ -n "$AGENT" && -x "$AGENT" ]] || { echo "PROVIDER_ERROR=codex_missing"; return 50; }
      ;;
    openhands)
      AGENT="${LIFEOS_OPENHANDS_BIN:-$HOME/.local/bin/openhands}"; [[ -x "$AGENT" ]] || AGENT=$(command -v openhands 2>/dev/null || true)
      [[ -n "$AGENT" && -x "$AGENT" ]] || { echo "PROVIDER_ERROR=openhands_missing"; return 50; }
      if [[ "$PROVIDER" == "governor-broker" ]]; then load_governor_broker; else
        [[ -n "$MODEL" ]] || { echo "PROVIDER_ERROR=openhands_model_missing"; return 51; }
        load_selected_credentials; export LLM_MODEL="$MODEL"; export LIFEOS_PROVIDER="$PROVIDER"
      fi
      ;;
    *) echo "PROVIDER_ERROR=unsupported_adapter adapter=$ADAPTER"; return 52 ;;
  esac
}

run_bounded() {
  /usr/bin/timeout --signal=TERM --kill-after=15s "${AGENT_TIMEOUT_SECONDS}s" "$@"
}

run_agent() {
  case "$ADAPTER" in
    codex)
      HELP=$($AGENT exec --help 2>&1 || true)
      if grep -q -- '--full-auto' <<<"$HELP"; then run_bounded "$AGENT" exec --full-auto "$PROMPT" </dev/null
      elif "$AGENT" --help 2>&1 | grep -q -- '--full-auto'; then run_bounded "$AGENT" --full-auto exec "$PROMPT" </dev/null
      else run_bounded "$AGENT" exec "$PROMPT" </dev/null; fi
      ;;
    openhands)
      # Headless OpenHands has no human available to approve tool actions. Without
      # an explicit non-interactive approval policy it can emit the correct action
      # and immediately finish without executing it (direct #759 proof,
      # run 35526869274 attempt 2: terminal action security_risk=MEDIUM).
      # --always-approve delegates the engineering loop to OpenHands as intended.
      # The security boundary remains the disposable Engineer worktree/VM plus the
      # Governor's routing, publication and independent acceptance controls.
      run_bounded "$AGENT" --headless --always-approve --override-with-envs -t "$PROMPT" </dev/null
      ;;
  esac
}

stage resolve_agent_start
resolve_agent
stage resolve_agent_pass
if [[ "$ADAPTER" == openhands ]]; then
  OPENHANDS_VERSION=$("$AGENT" --version 2>&1 | head -1 || true)
  OPENHANDS_HELP=$("$AGENT" --help 2>&1 || true)
  grep -q -- '--headless' <<<"$OPENHANDS_HELP" || { echo 'PROVIDER_ERROR=openhands_headless_flag_missing'; exit 54; }
  grep -q -- '--always-approve' <<<"$OPENHANDS_HELP" || { echo 'PROVIDER_ERROR=openhands_always_approve_flag_missing'; exit 54; }
  echo "OPENHANDS_VERSION=$OPENHANDS_VERSION"
  echo 'OPENHANDS_HEADLESS_CAPABILITY=PASS'
  echo 'OPENHANDS_NONINTERACTIVE_APPROVAL_CAPABILITY=PASS'
  stage openhands_cli_capabilities_pass
fi
echo "PROVIDER_SELECTED=$PROVIDER"
echo "PROVIDER_ADAPTER=$ADAPTER"
[[ -n "$MODEL" ]] && echo "PROVIDER_MODEL=$MODEL"
cd "$REPO"

WORKROOT="$HOME/.local/share/lifeos-agent/worktrees"
WORKTREE="$WORKROOT/${JOB_ID}-${ITERATION}-${PROVIDER}"
mkdir -p "$WORKROOT"
git worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true
rm -rf "$WORKTREE"
stage worktree_prepare_start
git worktree add --detach "$WORKTREE" origin/main >/dev/null
stage worktree_prepare_pass
cleanup() { git -C "$REPO" worktree remove --force "$WORKTREE" >/dev/null 2>&1 || true; }
trap cleanup EXIT
cd "$WORKTREE"
BASE=$(git rev-parse HEAD)
echo "WORKTREE_BASE=$BASE"

AGENT_LOG=$(mktemp)
trap 'rm -f "$AGENT_LOG"; cleanup' EXIT
stage agent_process_start
set +e
run_agent 2>&1 | tee "$AGENT_LOG"
AGENT_RC=${PIPESTATUS[0]}
set -e
echo "OPENHANDS_AGENT_PROCESS_RC=$AGENT_RC"
stage agent_process_returned
if (( AGENT_RC == 124 || AGENT_RC == 137 )); then
  echo "HANDOFF_ERROR=agent_timeout_${AGENT_TIMEOUT_SECONDS}s"
  exit "$AGENT_RC"
fi
(( AGENT_RC == 0 )) || { echo "HANDOFF_ERROR=agent_exit_${AGENT_RC}"; exit "$AGENT_RC"; }
# OpenHands/Codex owns the engineering session; Governor owns acceptance.
# Do not parse or gate on an agent self-verdict here. A zero-exit OTS session
# hands its artifacts and evidence to Governor's independent verifier (#759/#764).
echo "AGENT_SESSION=completed"
stage artifact_collection_start

git reset --mixed "$BASE" >/dev/null 2>&1 || true
git add -A
PATCH_FILE=$(mktemp)
git diff --cached --binary "$BASE" -- . >"$PATCH_FILE"
PATCH_BYTES=$(wc -c <"$PATCH_FILE")
echo "OPENHANDS_WORKTREE_PATCH_BYTES=$PATCH_BYTES"
stage git_diff_collected
if (( PATCH_BYTES > 1048576 )); then rm -f "$PATCH_FILE"; echo "HANDOFF_ERROR=patch_exceeds_1MiB"; exit 61; fi
RUNTIME_PRESENT=0
[[ -f "$RUNTIME_PATH" ]] && RUNTIME_PRESENT=1
echo "OPENHANDS_RUNTIME_PRESENT=$RUNTIME_PRESENT"
if (( PATCH_BYTES == 0 && RUNTIME_PRESENT == 0 )); then
  # A verification/disposition job can legitimately prove the requested state
  # is already satisfied without changing source or launching Pi runtime work.
  # Evidence-only sessions are valid; Governor decides whether they satisfy the goal.
  echo "HANDOFF_BASE=$BASE"
  echo "HANDOFF_PATCH_BYTES=0"
  echo "HANDOFF_NO_CHANGE=PASS"
  echo "HANDOFF_EVIDENCE_ONLY=PASS"
  echo "WORKTREE_STATUS_BEGIN"
  git status --short
  echo "WORKTREE_STATUS_END"
  rm -f "$PATCH_FILE"
  exit 0
fi

echo "HANDOFF_BASE=$BASE"
echo "HANDOFF_PATCH_BYTES=$PATCH_BYTES"
if (( PATCH_BYTES > 0 )); then echo "HANDOFF_PATCH_B64=$(base64 -w0 <"$PATCH_FILE")"; fi
rm -f "$PATCH_FILE"
if (( RUNTIME_PRESENT == 1 )); then
  RUNTIME_BYTES=$(wc -c <"$RUNTIME_PATH")
  if (( RUNTIME_BYTES > 65536 )); then echo "HANDOFF_ERROR=runtime_script_exceeds_64KiB"; exit 62; fi
  echo "RUN_SCRIPT=$RUNTIME_PATH"
  echo "HANDOFF_RUNTIME_B64=$(base64 -w0 <"$RUNTIME_PATH")"
fi
echo "WORKTREE_STATUS_BEGIN"
git status --short
echo "WORKTREE_STATUS_END"
