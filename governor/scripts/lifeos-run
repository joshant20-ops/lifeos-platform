#!/usr/bin/env bash
set -Eeuo pipefail
# Canonical governed entry point for private Personal Administration capabilities.
# Callers must use this launcher rather than invoking implementation adapters directly.
capability="${1:-}"; action="${2:-}"
case "$capability:$action" in
  email-paperless-selective:acceptance)
    repo=${LIFEOS_PLATFORM_REPO:-/home/joshan/lifeos-platform}
    adapter="$repo/homelab/live/home/joshan/automation/lifeos_email_paperless_selective.py"
    test -f "$adapter"
    password_source=
    for candidate in gmail-imap-password gmail-app-password imap-password; do
      if sudo -n test -s "/etc/lifeos/secrets/$candidate"; then password_source="/etc/lifeos/secrets/$candidate"; break; fi
    done
    test -n "$password_source" || { echo 'LIFEOS_CAPABILITY_BOUNDARY=CREDENTIAL_UNAVAILABLE'; exit 20; }
    sudo -n systemd-run --quiet --wait --pipe --collect       --unit=lifeos-pa-email-paperless-acceptance       --property=User=joshan       --property=WorkingDirectory="$repo"       --property=LoadCredential=gmail-imap-user:/etc/lifeos/secrets/gmail-imap-user       --property=LoadCredential=gmail-imap-password:"$password_source"       --property=LoadCredential=paperless-api-token:/etc/lifeos/secrets/paperless-api-token       /usr/bin/python3 "$adapter" acceptance
    ;;
  *) echo "usage: lifeos-run email-paperless-selective acceptance" >&2; exit 64 ;;
esac
