[Unit]
Description=LifeOS bounded control-job submission request
Requires=lifeos-control-job-submit.socket

[Service]
Type=oneshot
User=lifeos-control-submit
Group=lifeos-control-submit
EnvironmentFile=/etc/lifeos-control/control-job-submit.conf
ExecStart=/usr/local/libexec/lifeos-control-job-submit-bridge
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0027
RuntimeDirectory=lifeos-control-submit
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/joshan/lifeos-pi-control/jobs/staging
ReadWritePaths=/home/joshan/lifeos-pi-control/jobs/scripts
ReadWritePaths=/home/joshan/lifeos-pi-control/jobs/change-scripts
ReadWritePaths=/home/joshan/lifeos-pi-control/jobs/root-scripts
ReadWritePaths=/run/lifeos-control-submit
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
