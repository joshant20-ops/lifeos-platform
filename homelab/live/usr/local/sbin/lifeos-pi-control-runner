#!/usr/bin/env bash
set -Eeuo pipefail

REPO="${LIFEOS_CONTROL_REPO:-/home/joshan/lifeos-pi-control}"
STATE_DIR="/home/joshan/.local/state/lifeos-pi-control"
LOCAL_LOGS="$STATE_DIR/logs"
LOCK="$STATE_DIR/runner.lock"
PAUSE_FILE="$STATE_DIR/paused_job"
MAX_JOBS_PER_RUN=50
mkdir -p "$STATE_DIR" "$LOCAL_LOGS"

exec 9>"$LOCK"
flock -n 9 || { echo "Another control runner is active"; exit 0; }

ts(){ date --iso-8601=seconds; }
die(){ echo "REJECTED: $*" >&2; exit 20; }

critical_health(){
  local c
  for c in homeassistant lifeos-energy predbat vaultwarden uptime-kuma prometheus autoheal watchtower; do
    docker ps --format '{{.Names}}' | grep -Fxq "$c" || return 1
  done
}

sync_repo(){
  cd "$REPO"
  git fetch origin main
  local local_sha remote_sha
  local_sha="$(git rev-parse HEAD)"
  remote_sha="$(git rev-parse origin/main)"
  if [ "$local_sha" != "$remote_sha" ]; then
    git merge-base --is-ancestor "$local_sha" "$remote_sha" || die "non-fast-forward remote history"
    git merge --ff-only origin/main
  fi
}

select_manifest(){
  local paused=""
  [ -f "$PAUSE_FILE" ] && paused="$(cat "$PAUSE_FILE")"

  if [ -z "$paused" ]; then
    find jobs/pending -maxdepth 1 -type f -name '*.json' -printf '%f\n' 2>/dev/null | sort | head -n1
    return 0
  fi

  python3 - "$paused" <<'PY'
import json, pathlib, sys
paused=sys.argv[1]
for p in sorted(pathlib.Path('jobs/pending').glob('*.json')):
    try:
        d=json.loads(p.read_text())
    except Exception:
        continue
    if d.get('resume_after') == paused:
        print(p.name)
        break
PY
}

process_one(){
  local manifest_name="$1"
  local MANIFEST="jobs/pending/$manifest_name"
  local job_id job_type script script_sha256 timeout_seconds change_scope change_policy requires_root resume_after
  local -a FIELDS

  # Use one field per line. Bash IFS whitespace parsing collapses adjacent tabs,
  # which previously shifted empty diagnostic fields and lost resume_after.
  mapfile -t FIELDS < <(
    python3 - "$MANIFEST" <<'PY'
import json, pathlib, re, sys
p=pathlib.Path(sys.argv[1])
d=json.loads(p.read_text())
req=['schema_version','job_id','target','job_type','script','script_sha256','timeout_seconds','created_by','description']
missing=[x for x in req if x not in d]
if missing: raise SystemExit('missing fields: '+','.join(missing))
if d['schema_version'] != 1: raise SystemExit('unsupported schema_version')
if d['target'] != 'pi5': raise SystemExit('wrong target')
if d['job_type'] not in ('diagnostic','change'): raise SystemExit('job_type not enabled')
if not re.fullmatch(r'[A-Za-z0-9._-]{1,100}', d['job_id']): raise SystemExit('invalid job_id')
if not re.fullmatch(r'[0-9a-f]{64}', d['script_sha256']): raise SystemExit('invalid sha256')
if not isinstance(d['timeout_seconds'], int) or not 1 <= d['timeout_seconds'] <= 900: raise SystemExit('timeout_seconds out of range')
resume=d.get('resume_after','')
if resume and not re.fullmatch(r'[A-Za-z0-9._-]{1,100}', resume): raise SystemExit('invalid resume_after')
scope=policy=''
requires_root=False
if d['job_type'] == 'diagnostic':
    if not re.fullmatch(r'jobs/scripts/[A-Za-z0-9._-]+\.sh', d['script']): raise SystemExit('invalid diagnostic script path')
else:
    for key in ('change_scope','change_policy','requires_root'):
        if key not in d: raise SystemExit('missing change field: '+key)
    scope=d['change_scope']; policy=d['change_policy']; requires_root=d['requires_root']
    if policy != 'gated-v1': raise SystemExit('change_policy not enabled')
    if scope == 'control-state':
        if requires_root is not False: raise SystemExit('control-state cannot require root')
        if not re.fullmatch(r'jobs/change-scripts/[A-Za-z0-9._-]+\.sh', d['script']): raise SystemExit('invalid control-state script path')
    elif scope == 'root-broker':
        raise SystemExit('root-broker jobs are disabled')
    else:
        raise SystemExit('change_scope not enabled')
for value in (
    d['job_id'], d['job_type'], d['script'], d['script_sha256'],
    str(d['timeout_seconds']), scope, policy, str(requires_root).lower(), resume
):
    print(value)
PY
  ) || die "manifest validation failed: $MANIFEST"

  [ "${#FIELDS[@]}" -eq 9 ] || die "manifest parser returned ${#FIELDS[@]} fields, expected 9"
  job_id="${FIELDS[0]}"
  job_type="${FIELDS[1]}"
  script="${FIELDS[2]}"
  script_sha256="${FIELDS[3]}"
  timeout_seconds="${FIELDS[4]}"
  change_scope="${FIELDS[5]}"
  change_policy="${FIELDS[6]}"
  requires_root="${FIELDS[7]}"
  resume_after="${FIELDS[8]}"

  [ -n "$job_id" ] && [ -n "$job_type" ] && [ -n "$script" ] && [ -n "$script_sha256" ] && [ -n "$timeout_seconds" ] || die "manifest parser incomplete"
  [ -f "$script" ] || die "script missing: $script"

  local ACTUAL
  ACTUAL="$(sha256sum "$script" | awk '{print $1}')"
  [ "$ACTUAL" = "$script_sha256" ] || die "script checksum mismatch"

  gitleaks dir "$MANIFEST" --no-banner --no-color --redact >/dev/null
  gitleaks dir "$script" --no-banner --no-color --redact >/dev/null

  [ ! -e "results/${job_id}.json" ] || die "job already completed"
  [ ! -e "jobs/archive/${job_id}.json" ] || die "job already archived"

  if [ "$job_type" = "change" ]; then
    /usr/local/sbin/lifeos-ansible-adopt --status >/dev/null || die "V3 pre-change baseline failed"
    critical_health || die "critical container pre-change baseline failed"
    [ "$change_scope" = "control-state" ] || die "change scope refused"
    [ "$requires_root" = "false" ] || die "root changes disabled"
  fi

  mkdir -p results jobs/archive state
  local RUN_LOG="$LOCAL_LOGS/${job_id}.log"
  local START_ISO START_EPOCH MANIFEST_COMMIT RC END_ISO END_EPOCH ELAPSED CLASS OUTPUT_PATH OUTPUT_WITHHELD
  START_ISO="$(ts)"; START_EPOCH="$(date +%s)"; MANIFEST_COMMIT="$(git rev-parse HEAD)"

  set +e
  LIFEOS_JOB_ID="$job_id" LIFEOS_CONTROL_REPO="$REPO" timeout --signal=TERM --kill-after=5s "${timeout_seconds}s" bash "$script" >"$RUN_LOG" 2>&1
  RC=$?
  set -e

  if [ "$RC" -eq 0 ] && [ "$job_type" = "change" ]; then
    /usr/local/sbin/lifeos-ansible-adopt --status >>"$RUN_LOG" 2>&1 || RC=91
    critical_health >>"$RUN_LOG" 2>&1 || RC=92
  fi

  END_ISO="$(ts)"; END_EPOCH="$(date +%s)"; ELAPSED=$((END_EPOCH-START_EPOCH))
  CLASS="FAIL"; [ "$RC" -eq 0 ] && CLASS="PASS"; [ "$RC" -eq 124 ] && CLASS="TIMEOUT"

  OUTPUT_PATH="results/${job_id}.log"; OUTPUT_WITHHELD=false
  if gitleaks dir "$RUN_LOG" --no-banner --no-color --redact >/dev/null 2>&1; then
    cp "$RUN_LOG" "$OUTPUT_PATH"
  else
    OUTPUT_WITHHELD=true
    rm -f "$OUTPUT_PATH"
  fi

  python3 - "$MANIFEST" "results/${job_id}.json" "$MANIFEST_COMMIT" "$ACTUAL" "$START_ISO" "$END_ISO" "$ELAPSED" "$RC" "$CLASS" "$OUTPUT_WITHHELD" <<'PY'
import json, pathlib, socket, sys
m=json.loads(pathlib.Path(sys.argv[1]).read_text())
out={'schema_version':1,'job_id':m['job_id'],'job_type':m['job_type'],'target':'pi5','manifest_commit':sys.argv[3],'script':m['script'],'script_sha256':sys.argv[4],'started_at':sys.argv[5],'finished_at':sys.argv[6],'elapsed_seconds':int(sys.argv[7]),'exit_code':int(sys.argv[8]),'classification':sys.argv[9],'host':socket.gethostname(),'output_withheld':sys.argv[10].lower()=='true','output_path':None if sys.argv[10].lower()=='true' else f"results/{m['job_id']}.log"}
if m['job_type']=='change':
    out['change_scope']=m['change_scope']; out['change_policy']=m['change_policy']; out['requires_root']=m['requires_root']
if 'resume_after' in m: out['resume_after']=m['resume_after']
pathlib.Path(sys.argv[2]).write_text(json.dumps(out,indent=2)+'\n')
PY

  cp "$MANIFEST" "jobs/archive/${job_id}.json"
  rm "$MANIFEST"

  python3 - "$job_id" "$CLASS" "$END_ISO" "$MANIFEST_COMMIT" <<'PY'
import json, pathlib, sys
pathlib.Path('state/pi5.json').write_text(json.dumps({'schema_version':1,'last_job_id':sys.argv[1],'last_result':sys.argv[2],'updated_at':sys.argv[3],'manifest_commit':sys.argv[4]},indent=2)+'\n')
PY

  gitleaks dir results --no-banner --no-color --redact >/dev/null || die "result safety gate failed"
  git add jobs/pending jobs/archive results state
  git -c user.name="LifeOS Pi Control" -c user.email="lifeos-pi-control@localhost" commit -m "result: ${job_id} ${CLASS}"
  git fetch origin main
  git rebase origin/main
  git push origin main

  echo "JOB ${job_id}: ${CLASS} rc=${RC} elapsed=${ELAPSED}s type=${job_type} scope=${change_scope:-none} resume_after=${resume_after:-none}"

  if [ "$CLASS" != "PASS" ]; then
    printf '%s\n' "$job_id" >"$PAUSE_FILE"
    echo "QUEUE PAUSED after ${job_id}; awaiting a job with resume_after=${job_id}"
    return 10
  fi

  if [ -f "$PAUSE_FILE" ] && [ -n "${resume_after:-}" ] && [ "$(cat "$PAUSE_FILE")" = "$resume_after" ]; then
    rm -f "$PAUSE_FILE"
    echo "QUEUE RESUMED after successful repair job ${job_id}"
  fi

  return 0
}

sync_repo
COUNT=0
while [ "$COUNT" -lt "$MAX_JOBS_PER_RUN" ]; do
  MANIFEST_NAME="$(select_manifest)"
  if [ -z "$MANIFEST_NAME" ]; then
    if [ -f "$PAUSE_FILE" ]; then
      echo "Queue paused on $(cat "$PAUSE_FILE"); no matching resume job"
    else
      echo "No pending jobs"
    fi
    exit 0
  fi

  COUNT=$((COUNT+1))
  echo "===== CONTROL JOB ${COUNT}: ${MANIFEST_NAME} ====="

  set +e
  process_one "$MANIFEST_NAME"
  RC=$?
  set -e

  if [ "$RC" -eq 10 ]; then
    exit 0
  fi
  [ "$RC" -eq 0 ] || exit "$RC"

  echo "Result uploaded; immediately checking GitHub for next job..."
  sync_repo
done

echo "Reached safety cap of ${MAX_JOBS_PER_RUN} jobs; timer will resume later"
