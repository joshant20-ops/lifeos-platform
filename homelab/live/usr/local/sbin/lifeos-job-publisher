#!/usr/bin/env python3
import fcntl
import hashlib
import json
import os
import pathlib
import pwd
import re
import subprocess
import sys

REPO = pathlib.Path('/home/joshan/lifeos-pi-control')
STAGING = REPO / 'jobs/staging'
PENDING = REPO / 'jobs/pending'
ARCHIVE = REPO / 'jobs/archive'
RESULTS = REPO / 'results'
STATE_DIR = REPO / 'state'
LOCK = STATE_DIR / 'publisher.lock'
SCRIPT_ROOTS = {
    'diagnostic': REPO / 'jobs/scripts',
    'control-state': REPO / 'jobs/change-scripts',
    'root-broker': REPO / 'jobs/root-scripts',
}
RUNTIME_SPECS = (
    'jobs/staging', 'jobs/staged', 'jobs/pending', 'jobs/archive', 'jobs/scripts',
    'jobs/change-scripts', 'jobs/root-scripts', 'results', 'state',
)
JOB_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$')
GIT_USER = 'joshan'
GIT_HOME = '/home/joshan'
GIT_BIN = '/usr/bin/git'
RUNUSER_BIN = '/usr/sbin/runuser'
ENV_BIN = '/usr/bin/env'
GIT_ENV = (
    f'HOME={GIT_HOME}',
    'PATH=/usr/bin:/bin',
    'LANG=C.UTF-8',
)


def fail(msg, code=1):
    print(f'PUBLISH REJECTED: {msg}', file=sys.stderr)
    raise SystemExit(code)


def sha256(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()


def gitleaks(path):
    return subprocess.run([
        'gitleaks', 'dir', str(path), '--no-banner', '--no-color', '--redact'
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def git(*args, check=True, capture=False):
    """Run Git with a fixed repository-owner identity and deterministic environment."""
    euid = os.geteuid()
    try:
        current_user = pwd.getpwuid(euid).pw_name
    except KeyError:
        fail(f'publisher git identity unresolved for uid={euid}')

    if euid == 0:
        command = [
            RUNUSER_BIN, '-u', GIT_USER, '--',
            ENV_BIN, '-i', *GIT_ENV,
            GIT_BIN, *args,
        ]
        env = None
    elif current_user == GIT_USER:
        command = [GIT_BIN, *args]
        env = {
            'HOME': GIT_HOME,
            'PATH': '/usr/bin:/bin',
            'LANG': 'C.UTF-8',
        }
    else:
        fail(f'publisher git identity must be root or {GIT_USER}, got {current_user}')

    return subprocess.run(
        command,
        cwd=REPO,
        env=env,
        text=True,
        check=check,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
    )


def upstream_runtime_paths():
    return git(
        'ls-tree', '-r', '--name-only', 'origin/main', '--', *RUNTIME_SPECS,
        check=False, capture=True,
    )


def sync_repo():
    """Safely fast-forward control definitions without touching runtime state."""
    tracked = upstream_runtime_paths()
    if tracked.returncode == 0 and tracked.stdout.strip():
        fail('origin/main tracks runtime-owned paths; migration required before sync', 20)

    before = git('rev-parse', 'HEAD', capture=True).stdout.strip()
    git(
        'fetch', '--no-write-fetch-head', 'origin',
        '+refs/heads/main:refs/remotes/origin/main',
    )
    after = git('rev-parse', 'HEAD', capture=True).stdout.strip()
    if after != before:
        fail('fetch unexpectedly changed checked-out HEAD', 20)

    tracked = upstream_runtime_paths()
    if tracked.returncode == 0 and tracked.stdout.strip():
        fail('origin/main tracks runtime-owned paths; refusing unsafe merge', 20)

    dirty = git('status', '--porcelain=v1', '--untracked-files=no', capture=True)
    if dirty.stdout.strip():
        fail('tracked working tree changes prevent safe fast-forward', 20)

    git('merge', '--ff-only', 'refs/remotes/origin/main')


def validate_manifest(path):
    try:
        d = json.loads(path.read_text())
    except Exception as exc:
        fail(f'{path.name}: invalid JSON: {exc}')

    required = {
        'schema_version','job_id','target','job_type','script','script_sha256',
        'timeout_seconds','created_by','description'
    }
    missing = required - set(d)
    if missing:
        fail(f"{path.name}: missing manifest fields: {','.join(sorted(missing))}")

    if d['schema_version'] != 1:
        fail(f'{path.name}: unsupported schema_version')
    if not isinstance(d['job_id'], str) or not JOB_RE.fullmatch(d['job_id']):
        fail(f'{path.name}: invalid job_id')
    if path.stem != d['job_id']:
        fail(f'{path.name}: filename/job_id mismatch')
    if not isinstance(d['target'], str) or not d['target']:
        fail(f'{path.name}: invalid target')
    if d['job_type'] not in {'diagnostic','change'}:
        fail(f'{path.name}: invalid job_type')
    if not isinstance(d['timeout_seconds'], int) or not 1 <= d['timeout_seconds'] <= 900:
        fail(f'{path.name}: timeout_seconds out of range')
    if not isinstance(d['created_by'], str) or not d['created_by']:
        fail(f'{path.name}: created_by required')
    if not isinstance(d['description'], str) or not d['description']:
        fail(f'{path.name}: description required')

    if d['job_type'] == 'diagnostic':
        scope = 'diagnostic'
        if any(k in d for k in ('change_scope','change_policy','requires_root')):
            fail(f'{path.name}: diagnostic contains change-only fields')
    else:
        for key in ('change_scope','change_policy','requires_root'):
            if key not in d:
                fail(f'{path.name}: missing {key}')
        if d['change_policy'] != 'gated-v1':
            fail(f'{path.name}: unsupported change policy')
        scope = d['change_scope']
        if scope not in {'control-state','root-broker'}:
            fail(f'{path.name}: change scope not allowlisted')
        if scope == 'control-state' and d['requires_root'] is not False:
            fail(f'{path.name}: control-state requires_root must be false')
        if scope == 'root-broker' and d['requires_root'] is not True:
            fail(f'{path.name}: root-broker requires_root must be true')

    if 'resume_after' in d and (not isinstance(d['resume_after'], str) or not d['resume_after']):
        fail(f'{path.name}: invalid resume_after')

    expected_prefix = {
        'diagnostic': 'jobs/scripts/',
        'control-state': 'jobs/change-scripts/',
        'root-broker': 'jobs/root-scripts/',
    }[scope]
    script_rel = d['script']
    if not isinstance(script_rel, str) or not script_rel.startswith(expected_prefix):
        fail(f'{path.name}: script path outside allowed root')

    try:
        allowed_root = SCRIPT_ROOTS[scope].resolve(strict=True)
        script = (REPO / script_rel).resolve(strict=True)
        script.relative_to(allowed_root)
    except (FileNotFoundError, RuntimeError, ValueError):
        fail(f'{path.name}: script path escapes allowed root')

    if not script.is_file():
        fail(f'{path.name}: referenced script missing: {script_rel}')

    actual = sha256(script)
    if actual != d['script_sha256']:
        fail(f'{path.name}: checksum mismatch expected={d["script_sha256"]} actual={actual}')

    for final in (PENDING/path.name, ARCHIVE/path.name, RESULTS/f'{d["job_id"]}.json'):
        if final.exists():
            fail(f'{path.name}: job_id already exists at {final.relative_to(REPO)}')

    if not gitleaks(path):
        fail(f'{path.name}: manifest failed Gitleaks')
    if not gitleaks(script):
        fail(f'{path.name}: script failed Gitleaks')

    return d, script


def pending_for_target(target):
    for path in sorted(PENDING.glob('*.json')):
        try:
            data = json.loads(path.read_text())
        except Exception:
            fail(f'{path.name}: existing pending manifest is invalid JSON')
        if data.get('target') == target:
            return path
    return None


def promote_one(manifest, d, script):
    dest = PENDING / manifest.name
    try:
        os.link(manifest, dest)
    except FileExistsError:
        fail(f'{manifest.name}: pending destination already exists')
    except OSError as exc:
        fail(f'{manifest.name}: atomic pending promotion failed: {exc}')
    manifest.unlink()
    print(f'PUBLISHED: {d["job_id"]} target={d["target"]}')


def publish_locked():
    STAGING.mkdir(parents=True, exist_ok=True)
    PENDING.mkdir(parents=True, exist_ok=True)
    ARCHIVE.mkdir(parents=True, exist_ok=True)
    RESULTS.mkdir(parents=True, exist_ok=True)

    sync_repo()

    manifests = sorted(STAGING.glob('*.json'))
    if not manifests:
        print('No staged manifests')
        return 0

    # Strict FIFO: only the oldest staged manifest is considered per run.
    # An invalid oldest item blocks later work rather than allowing queue bypass.
    manifest = manifests[0]
    d, script = validate_manifest(manifest)

    existing = pending_for_target(d['target'])
    if existing is not None:
        print(f'HOLD: target={d["target"]} already has pending job {existing.stem}')
        print('Publisher summary: promoted=0 rejected=0 held=1')
        return 0

    promote_one(manifest, d, script)
    print('Publisher summary: promoted=1 rejected=0 held=0')
    return 0


def main():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK.open('a') as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        return publish_locked()


if __name__ == '__main__':
    raise SystemExit(main())
