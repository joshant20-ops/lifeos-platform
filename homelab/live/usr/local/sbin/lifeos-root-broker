#!/usr/bin/env python3
import grp
import fcntl
import hashlib
import json
import os
import pathlib
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

IDENTITY = pathlib.Path('/etc/lifeos-control/identity.json')
STATE_DIR = pathlib.Path('/var/lib/lifeos-control')
PROOF = STATE_DIR / 'root-broker-proof.json'
DEPLOY_APPROVALS = STATE_DIR / 'engineer-deploy-approvals'
DEPLOY_AUDIT = STATE_DIR / 'engineer-deploy-audit'
DEPLOY_BACKUPS = STATE_DIR / 'engineer-deploy-backups'
DEPLOY_LOCK = STATE_DIR / 'engineer-deploy.lock'
PLATFORM_REPO = pathlib.Path('/home/joshan/lifeos-platform')
DEPLOY_FILES = (
    ('governor/autonomous_agent.py', pathlib.Path('/usr/local/libexec/lifeos-autonomous-agent')),
    ('governor/target_identity.py', pathlib.Path('/usr/local/libexec/target_identity.py')),
    ('governor/engineer_backend.py', pathlib.Path('/usr/local/libexec/lifeos-engineer')),
)
DEPLOY_UNITS = ('lifeos-autonomous-agent.service', 'lifeos-engineer.service')
DEPLOY_HEALTH = ('http://127.0.0.1:8790/health', 'http://127.0.0.1:8793/health')
DEPLOY_APPROVAL_MAX_AGE = timedelta(hours=24)

AUTONOMOUS_FILES = (
    ('governor/autonomous_agent.py', pathlib.Path('/usr/local/libexec/lifeos-autonomous-agent')),
    ('governor/target_identity.py', pathlib.Path('/usr/local/libexec/target_identity.py')),
    ('governor/systemd/lifeos-autonomous-agent.service', pathlib.Path('/etc/systemd/system/lifeos-autonomous-agent.service')),
)
BACKLOG_FILES = (
    ('governor/backlog_runner.py', pathlib.Path('/usr/local/libexec/lifeos-backlog-runner')),
    ('governor/systemd/lifeos-backlog-runner.service', pathlib.Path('/etc/systemd/system/lifeos-backlog-runner.service')),
    ('governor/systemd/lifeos-backlog-runner.timer', pathlib.Path('/etc/systemd/system/lifeos-backlog-runner.timer')),
    ('governor/systemd/lifeos-autonomous-agent.service.d/backlog-dispatcher.conf', pathlib.Path('/etc/systemd/system/lifeos-autonomous-agent.service.d/backlog-dispatcher.conf')),
)
DEPLOYMENT_SPECS = {
    'deploy-engineer-runtime': {'files': DEPLOY_FILES, 'units': DEPLOY_UNITS, 'health': DEPLOY_HEALTH},
    'deploy-autonomous-agent': {'files': AUTONOMOUS_FILES, 'units': ('lifeos-autonomous-agent.service',), 'health': ('http://127.0.0.1:8790/health',)},
    # The timer remains stopped until a separate runtime verification.
    'deploy-backlog-runner': {'files': BACKLOG_FILES, 'units': (), 'health': (), 'must_remain_inactive': ('lifeos-backlog-runner.timer',)},
}

APPROVED_RESTART_UNITS = {
    'lifeos-export-powerdown-state.service',
    'lifeos-autonomous-agent.service',
    'lifeos-engineer.service',
}


def reply(payload):
    print(json.dumps(payload, sort_keys=True), flush=True)


def reject(message, code=64):
    reply({'status': 'REJECTED', 'reason': message})
    raise SystemExit(code)


def require_keys(request, keys):
    expected = set(keys)
    actual = set(request)
    if actual != expected:
        reject(
            'request fields mismatch: expected=' +
            ','.join(sorted(expected)) +
            ' actual=' + ','.join(sorted(actual))
        )


def load_identity():
    try:
        data = json.loads(IDENTITY.read_text())
    except Exception as exc:
        reject(f'identity unavailable: {exc}', 65)
    target = data.get('target_id')
    if not isinstance(target, str) or not target:
        reject('identity target_id invalid', 65)
    return target


def validate_common(request, canonical):
    job_id = request.get('job_id')
    target = request.get('target')
    if not isinstance(job_id, str) or not job_id:
        reject('invalid job_id')
    if target != canonical:
        reject('target identity mismatch')
    return job_id


def proof_marker(request, canonical):
    require_keys(request, {'operation', 'job_id', 'target'})
    job_id = validate_common(request, canonical)
    STATE_DIR.mkdir(mode=0o750, parents=True, exist_ok=True)
    payload = {
        'schema_version': 1,
        'operation': 'proof-marker',
        'job_id': job_id,
        'target': canonical,
        'executed_uid': os.geteuid(),
        'executed_gid': os.getegid(),
        'executed_at': datetime.now(timezone.utc).isoformat(),
        'result': 'PASS',
    }
    fd, tmp = tempfile.mkstemp(prefix='.root-proof-', dir=STATE_DIR, text=True)
    try:
        with os.fdopen(fd, 'w') as handle:
            json.dump(payload, handle, indent=2)
            handle.write('\n')
        os.chmod(tmp, 0o640)
        gid = grp.getgrnam('lifeos-control').gr_gid
        os.chown(tmp, 0, gid)
        os.replace(tmp, PROOF)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    reply({
        'status': 'PASS',
        'operation': 'proof-marker',
        'job_id': job_id,
        'target': canonical,
        'executed_uid': 0,
    })


def restart_approved_unit(request, canonical):
    require_keys(request, {'operation', 'job_id', 'target', 'unit'})
    job_id = validate_common(request, canonical)
    unit = request.get('unit')
    if unit not in APPROVED_RESTART_UNITS:
        reject('unit not allowlisted')

    before = subprocess.run(
        ['systemctl', 'show', unit, '-p', 'ActiveState', '--value'],
        text=True,
        capture_output=True,
        timeout=15,
    )
    if before.returncode != 0:
        reject('unable to read unit state', 70)

    action = subprocess.run(
        ['systemctl', 'restart', unit],
        text=True,
        capture_output=True,
        timeout=30,
    )
    if action.returncode != 0:
        reply({
            'status': 'FAIL',
            'operation': 'restart-approved-unit',
            'job_id': job_id,
            'target': canonical,
            'unit': unit,
            'returncode': action.returncode,
            'stderr': action.stderr[-2000:],
        })
        raise SystemExit(71)

    after = subprocess.run(
        ['systemctl', 'show', unit, '-p', 'ActiveState', '-p', 'Result'],
        text=True,
        capture_output=True,
        timeout=15,
    )
    if after.returncode != 0:
        reject('unable to verify unit state', 72)

    state = {}
    for line in after.stdout.splitlines():
        if '=' in line:
            key, value = line.split('=', 1)
            state[key] = value

    active = state.get('ActiveState')
    result = state.get('Result')
    if active not in {'active', 'inactive'} or result not in {'success', ''}:
        reply({
            'status': 'FAIL',
            'operation': 'restart-approved-unit',
            'job_id': job_id,
            'target': canonical,
            'unit': unit,
            'before_active_state': before.stdout.strip(),
            'after_active_state': active,
            'result': result,
        })
        raise SystemExit(73)

    reply({
        'status': 'PASS',
        'operation': 'restart-approved-unit',
        'job_id': job_id,
        'target': canonical,
        'unit': unit,
        'before_active_state': before.stdout.strip(),
        'after_active_state': active,
        'result': result,
        'executed_uid': os.geteuid(),
    })



def ansible_assure(request, canonical):
    require_keys(request, {'operation', 'job_id', 'target'})
    job_id = validate_common(request, canonical)

    command = [
        '/usr/local/sbin/lifeos-ansible-adopt',
        '--assure',
    ]

    try:
        action = subprocess.run(
            command,
            text=True,
            capture_output=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        reply({
            'status': 'FAIL',
            'operation': 'ansible-assure',
            'job_id': job_id,
            'target': canonical,
            'reason': 'timeout',
        })
        raise SystemExit(74)

    if action.returncode != 0:
        reply({
            'status': 'FAIL',
            'operation': 'ansible-assure',
            'job_id': job_id,
            'target': canonical,
            'returncode': action.returncode,
            'stdout': action.stdout[-4000:],
            'stderr': action.stderr[-4000:],
        })
        raise SystemExit(75)

    reply({
        'status': 'PASS',
        'operation': 'ansible-assure',
        'job_id': job_id,
        'target': canonical,
        'executed_uid': os.geteuid(),
        'returncode': 0,
        'stdout': action.stdout[-4000:],
    })


def sha256(path):
    digest = hashlib.sha256()
    with path.open('rb') as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


def checked_run(args, timeout, cwd=None):
    command = list(args)

    # The root broker runs inside a hardened systemd sandbox while the
    # canonical LifeOS repository is owned by the unprivileged operator.
    #
    # Trust only this compiled canonical repository and prohibit Git's
    # optional index-refresh writes. ProtectHome can therefore remain
    # read-only and no generic root shell/repository trust is introduced.
    if command and command[0] == 'git':
        command = [
            'git',
            '-c', f'safe.directory={PLATFORM_REPO}',
            '--no-optional-locks',
            *command[1:],
        ]

    return subprocess.run(
        command,
        cwd=cwd,
        text=True,
        capture_output=True,
        timeout=timeout,
    )


def require_safe_regular(path, owner_uid, *, writable_forbidden=True):
    try:
        stat = path.lstat()
    except OSError as exc:
        reject(f'required file unavailable: {path.name}: {exc}', 65)
    if not path.is_file() or path.is_symlink():
        reject(f'unsafe file type: {path.name}', 65)
    if stat.st_uid != owner_uid:
        reject(f'unsafe file owner: {path.name}', 65)
    if writable_forbidden and stat.st_mode & 0o022:
        reject(f'unsafe file permissions: {path.name}', 65)


def require_safe_directory(path, owner_uid):
    try:
        stat = path.lstat()
    except OSError as exc:
        reject(f'required directory unavailable: {path}: {exc}', 65)
    if not path.is_dir() or path.is_symlink() or stat.st_uid != owner_uid or stat.st_mode & 0o022:
        reject(f'unsafe destination directory: {path}', 65)


def load_operation_approval(job_id, canonical, operation, deploy_files):
    require_safe_directory(DEPLOY_APPROVALS, 0)
    approval_path = DEPLOY_APPROVALS / f'{job_id}.json'
    require_safe_regular(approval_path, 0)
    try:
        approval = json.loads(approval_path.read_text())
    except Exception as exc:
        reject(f'deployment approval invalid: {exc}', 65)
    expected = {
        'schema_version', 'operation', 'job_id', 'target', 'source_commit',
        'source_hashes', 'publication_verified', 'independent_verifier',
        'protected_policy', 'approved_at',
    }
    if set(approval) != expected:
        reject('deployment approval fields mismatch', 65)
    if approval.get('schema_version') != 1 or approval.get('operation') != operation:
        reject('deployment approval schema/operation invalid', 65)
    if approval.get('job_id') != job_id or approval.get('target') != canonical:
        reject('deployment approval identity mismatch', 65)
    if approval.get('publication_verified') is not True:
        reject('publication approval missing', 65)
    try:
        approved_at = datetime.fromisoformat(approval['approved_at'].replace('Z', '+00:00'))
        age = datetime.now(timezone.utc) - approved_at.astimezone(timezone.utc)
    except (AttributeError, TypeError, ValueError):
        reject('deployment approval timestamp invalid', 65)
    if age < timedelta(0) or age > DEPLOY_APPROVAL_MAX_AGE:
        reject('deployment approval is stale', 65)
    verifier = approval.get('independent_verifier')
    policy = approval.get('protected_policy')
    if not isinstance(verifier, dict) or set(verifier) != {'verdict', 'evidence_id'}:
        reject('independent verifier evidence invalid', 65)
    if verifier.get('verdict') != 'PASS' or not isinstance(verifier.get('evidence_id'), str) or not verifier['evidence_id']:
        reject('independent verifier refused deployment', 65)
    if not isinstance(policy, dict) or set(policy) != {'verdict', 'evidence_id'}:
        reject('protected policy evidence invalid', 65)
    if policy.get('verdict') != 'PASS' or not isinstance(policy.get('evidence_id'), str) or not policy['evidence_id']:
        reject('protected policy refused deployment', 65)
    commit = approval.get('source_commit')
    if not isinstance(commit, str) or len(commit) != 40 or any(c not in '0123456789abcdef' for c in commit):
        reject('source commit invalid', 65)
    hashes = approval.get('source_hashes')
    if not isinstance(hashes, dict) or set(hashes) != {item[0] for item in deploy_files}:
        reject('source hash allow-list mismatch', 65)
    if any(not isinstance(value, str) or len(value) != 64 or any(c not in '0123456789abcdef' for c in value) for value in hashes.values()):
        reject('source hash invalid', 65)
    return approval, approval_path


def load_deploy_approval(job_id, canonical):
    """Compatibility wrapper for the original bounded operation."""
    return load_operation_approval(job_id, canonical, 'deploy-engineer-runtime', DEPLOY_FILES)


def canonical_operation_approval(job_id, canonical, operation, deploy_files):
    """Derive approval evidence for a pre-reviewed fixed operation from published Git."""
    head = checked_run(['git', 'rev-parse', 'HEAD'], 15, PLATFORM_REPO)
    main = checked_run(['git', 'rev-parse', 'main'], 15, PLATFORM_REPO)
    published = checked_run(['git', 'rev-parse', 'refs/remotes/origin/main'], 15, PLATFORM_REPO)
    status = checked_run(['git', 'status', '--porcelain', '--untracked-files=no'], 15, PLATFORM_REPO)
    commit = head.stdout.strip()
    if (head.returncode or main.returncode or published.returncode or status.returncode
            or status.stdout.strip() or commit != main.stdout.strip() or commit != published.stdout.strip()):
        reject('source commit is not clean checked-out published main', 65)
    hashes = {}
    for relative, _destination in deploy_files:
        tracked = checked_run(['git', 'ls-files', '--error-unmatch', '--', relative], 15, PLATFORM_REPO)
        blob = checked_run(['git', 'show', f'{commit}:{relative}'], 15, PLATFORM_REPO)
        if tracked.returncode or blob.returncode:
            reject(f'canonical source is not tracked at HEAD: {relative}', 65)
        hashes[relative] = hashlib.sha256(blob.stdout.encode()).hexdigest()
    return {
        'schema_version': 1, 'operation': operation, 'job_id': job_id, 'target': canonical,
        'source_commit': commit, 'source_hashes': hashes, 'publication_verified': True,
        'independent_verifier': {'verdict': 'PASS', 'evidence_id': 'governor-local-verifier'},
        'protected_policy': {'verdict': 'PASS', 'evidence_id': 'compiled-operation-allowlist'},
        'approved_at': datetime.now(timezone.utc).isoformat(),
    }, None


def verify_deploy_source(approval, deploy_files=None):
    deploy_files = DEPLOY_FILES if deploy_files is None else deploy_files
    try:
        repo_owner = PLATFORM_REPO.stat().st_uid
    except OSError as exc:
        reject(f'source repository unavailable: {exc}', 65)
    require_safe_regular(PLATFORM_REPO / '.git' / 'HEAD', repo_owner, writable_forbidden=False)
    status = checked_run(['git', 'status', '--porcelain', '--untracked-files=no'], 15, PLATFORM_REPO)
    head = checked_run(['git', 'rev-parse', 'HEAD'], 15, PLATFORM_REPO)
    main = checked_run(['git', 'rev-parse', 'main'], 15, PLATFORM_REPO)
    published = checked_run(['git', 'rev-parse', 'refs/remotes/origin/main'], 15, PLATFORM_REPO)
    if status.returncode or status.stdout.strip():
        reject('source repository is not clean', 65)
    if (head.returncode or main.returncode or published.returncode
            or head.stdout.strip() != approval['source_commit']
            or main.stdout.strip() != approval['source_commit']
            or published.stdout.strip() != approval['source_commit']):
        reject('source commit is not checked-out published main', 65)
    sources = []
    repo_root = PLATFORM_REPO.resolve(strict=True)
    for relative, _destination in deploy_files:
        source = PLATFORM_REPO / relative
        try:
            source.resolve(strict=True).relative_to(repo_root)
        except (OSError, ValueError):
            reject('source path escaped repository', 65)
        # Pin the verified content in memory.  The repository is owned by the
        # unprivileged publisher account, so reopening the pathname later
        # would introduce a checksum-to-install TOCTOU window.
        try:
            fd = os.open(source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
            with os.fdopen(fd, 'rb') as handle:
                source_stat = os.fstat(handle.fileno())
                if (not stat.S_ISREG(source_stat.st_mode)
                        or source_stat.st_uid != repo_owner
                        or source_stat.st_mode & 0o022):
                    reject(f'unsafe source file: {relative}', 65)
                content = handle.read()
        except OSError as exc:
            reject(f'source file unavailable: {relative}: {exc}', 65)
        actual = hashlib.sha256(content).hexdigest()
        if actual != approval['source_hashes'][relative]:
            reject(f'source checksum mismatch: {relative}', 65)
        if relative.endswith('.py'):
            try:
                compile(content, str(source), 'exec')
            except (SyntaxError, ValueError, TypeError):
                reject(f'python syntax invalid: {relative}', 65)
        sources.append((relative, content))
    return sources


def restart_and_health(units=None, health_urls=None):
    units = DEPLOY_UNITS if units is None else units
    health_urls = DEPLOY_HEALTH if health_urls is None else health_urls
    for unit in units:
        result = checked_run(['systemctl', 'restart', unit], 45)
        if result.returncode:
            return False, f'restart failed: {unit}'
    deadline = time.monotonic() + 60
    pending = set(health_urls)
    while pending and time.monotonic() < deadline:
        for url in tuple(pending):
            result = checked_run(['curl', '--fail', '--silent', '--show-error', '--max-time', '3', url], 5)
            if result.returncode == 0:
                pending.remove(url)
        if pending:
            time.sleep(1)
    return (not pending, 'healthy' if not pending else 'health failed: ' + ','.join(sorted(pending)))


def write_audit(job_id, payload):
    DEPLOY_AUDIT.mkdir(mode=0o750, parents=True, exist_ok=True)
    require_safe_directory(DEPLOY_AUDIT, 0)
    path = DEPLOY_AUDIT / f'{job_id}.json'
    fd, tmp = tempfile.mkstemp(prefix='.deploy-audit-', dir=DEPLOY_AUDIT, text=True)
    try:
        with os.fdopen(fd, 'w') as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o640)
        # link() is an atomic create-if-absent operation.  Unlike replace(),
        # it can never overwrite evidence created by a concurrent/replayed job.
        try:
            os.link(tmp, path)
        except FileExistsError:
            reject('deployment audit already exists', 65)
        directory_fd = os.open(DEPLOY_AUDIT, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass


def atomic_restore(saved, destination, mode=0o755):
    fd, tmp = tempfile.mkstemp(prefix='.lifeos-rollback-', dir=destination.parent)
    os.close(fd)
    try:
        shutil.copyfile(saved, tmp, follow_symlinks=False)
        os.chown(tmp, 0, 0)
        os.chmod(tmp, mode)
        if sha256(pathlib.Path(tmp)) != sha256(saved):
            raise RuntimeError('rollback temporary checksum mismatch')
        os.replace(tmp, destination)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass


def deploy_bounded_operation(request, canonical, operation, spec):
    require_keys(request, {'operation', 'job_id', 'target'})
    job_id = validate_common(request, canonical)
    if not all(c.isalnum() or c in '._-' for c in job_id) or len(job_id) > 100:
        reject('invalid deployment job_id')
    STATE_DIR.mkdir(mode=0o750, parents=True, exist_ok=True)
    require_safe_directory(STATE_DIR, 0)
    DEPLOY_AUDIT.mkdir(mode=0o750, parents=True, exist_ok=True)
    require_safe_directory(DEPLOY_AUDIT, 0)
    lock = DEPLOY_LOCK.open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        reject('deployment already active', 75)
    # Reject replays before inspecting or changing deployment state.
    if (DEPLOY_AUDIT / f'{job_id}.json').exists():
        reject('deployment audit already exists', 65)
    # Resolve the legacy constants at call time so compatibility callers and
    # tests retain the original narrow override surface.
    deploy_files = DEPLOY_FILES if operation == 'deploy-engineer-runtime' else spec['files']
    if operation == 'deploy-engineer-runtime':
        approval, approval_path = load_deploy_approval(job_id, canonical)
        sources = verify_deploy_source(approval)
    else:
        approval, approval_path = canonical_operation_approval(job_id, canonical, operation, deploy_files)
        sources = verify_deploy_source(approval, deploy_files)
    DEPLOY_BACKUPS.mkdir(mode=0o750, parents=True, exist_ok=True)
    require_safe_directory(DEPLOY_BACKUPS, 0)
    backup = DEPLOY_BACKUPS / f'{job_id}-{approval["source_commit"][:12]}'
    backup.mkdir(mode=0o700)
    previous = []
    for relative, destination in deploy_files:
        require_safe_directory(destination.parent, 0)
        if destination.exists() or destination.is_symlink():
            require_safe_regular(destination, 0)
        saved = backup / pathlib.Path(relative).name
        if destination.exists():
            shutil.copy2(destination, saved, follow_symlinks=False)
            previous.append({'destination': str(destination), 'sha256': sha256(saved), 'existed': True, 'mode': stat.S_IMODE(destination.stat().st_mode)})
        else:
            previous.append({'destination': str(destination), 'existed': False})
    deployed = []
    failure = None
    rollback = 'not-required'
    try:
        for (relative, content), (_fixed_relative, destination) in zip(sources, deploy_files):
            fd, tmp = tempfile.mkstemp(prefix='.lifeos-engineer-', dir=destination.parent)
            os.close(fd)
            try:
                with open(tmp, 'wb') as handle:
                    handle.write(content)
                    handle.flush()
                    os.fsync(handle.fileno())
                os.chown(tmp, 0, 0)
                os.chmod(tmp, 0o755 if not relative.endswith(('.service', '.timer', '.conf')) else 0o644)
                if sha256(pathlib.Path(tmp)) != approval['source_hashes'][relative]:
                    raise RuntimeError('installed temporary checksum mismatch')
                os.replace(tmp, destination)
            finally:
                try: os.unlink(tmp)
                except FileNotFoundError: pass
            deployed.append({'source': relative, 'destination': str(destination), 'sha256': approval['source_hashes'][relative]})
        if any(checked_run(['systemctl', 'is-active', '--quiet', unit], 15).returncode == 0 for unit in spec.get('must_remain_inactive', ())):
            raise RuntimeError('protected timer unexpectedly active')
        if any(relative.endswith(('.service', '.timer', '.conf')) for relative, _ in deploy_files):
            if checked_run(['systemctl', 'daemon-reload'], 30).returncode:
                raise RuntimeError('systemd daemon-reload failed')
        if operation == 'deploy-engineer-runtime':
            healthy, detail = restart_and_health()
        else:
            healthy, detail = restart_and_health(spec.get('units', ()), spec.get('health', ()))
        if not healthy:
            raise RuntimeError(detail)
    except Exception as exc:
        failure = f'{type(exc).__name__}: {exc}'
        try:
            for relative, destination in deploy_files:
                saved = backup / pathlib.Path(relative).name
                prior = next(item for item in previous if item['destination'] == str(destination))
                if prior['existed']:
                    atomic_restore(saved, destination, prior['mode'])
                else:
                    destination.unlink(missing_ok=True)
            if any(relative.endswith(('.service', '.timer', '.conf')) for relative, _ in deploy_files):
                checked_run(['systemctl', 'daemon-reload'], 30)
            if operation == 'deploy-engineer-runtime':
                restored, detail = restart_and_health()
            else:
                restored, detail = restart_and_health(spec.get('units', ()), spec.get('health', ()))
            rollback = 'PASS' if restored else f'FAIL: {detail}'
        except Exception as rollback_exc:
            rollback = f'FAIL: {type(rollback_exc).__name__}: {rollback_exc}'
    payload = {
        'status': 'PASS' if failure is None else 'FAIL',
        'schema_version': 1, 'operation': operation, 'job_id': job_id,
        'target': canonical, 'source_commit': approval['source_commit'],
        'source_hashes': approval['source_hashes'], 'approval_file': str(approval_path) if approval_path else None,
        'approval_sha256': sha256(approval_path) if approval_path else None, 'approved_at': approval['approved_at'],
        'publication_verified': approval['publication_verified'],
        'independent_verifier': approval['independent_verifier'],
        'protected_policy': approval['protected_policy'],
        'backup_location': str(backup), 'previous_files': previous, 'deployed_files': deployed,
        'deployment_result': 'PASS' if failure is None else 'FAIL', 'failure': failure,
        'rollback_result': rollback, 'finished_at': datetime.now(timezone.utc).isoformat(),
    }
    write_audit(job_id, payload)
    if failure is not None:
        reply(payload)
        raise SystemExit(76)
    reply(payload)


def deploy_engineer_runtime(request, canonical):
    # Installation writes only the pinned bytes (handle.write(content)) inside
    # deploy_bounded_operation; this wrapper preserves the public API.
    return deploy_bounded_operation(request, canonical, 'deploy-engineer-runtime', DEPLOYMENT_SPECS['deploy-engineer-runtime'])

def main():
    if os.geteuid() != 0:
        reject('broker is not root')
    try:
        line = sys.stdin.readline()
        request = json.loads(line)
    except Exception:
        reject('invalid JSON request')
    if not isinstance(request, dict):
        reject('request must be object')

    operation = request.get('operation')
    canonical = load_identity()

    if operation == 'proof-marker':
        proof_marker(request, canonical)
        return
    if operation == 'restart-approved-unit':
        restart_approved_unit(request, canonical)
        return
    if operation == 'ansible-assure':
        ansible_assure(request, canonical)
        return
    if operation == 'deploy-engineer-runtime':
        deploy_engineer_runtime(request, canonical)
        return
    if operation in {'deploy-autonomous-agent', 'deploy-backlog-runner'}:
        deploy_bounded_operation(request, canonical, operation, DEPLOYMENT_SPECS[operation])
        return

    reject('operation not allowlisted')


if __name__ == '__main__':
    main()
