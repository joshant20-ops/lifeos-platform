#!/usr/bin/env python3
import json, os, sys
sys.path.insert(0, "/usr/local/lib")
from lifeos_transaction import Controller, TransactionError
if os.geteuid() != 0 or len(sys.argv) not in {2, 3}:
    print("lifeos-rollback requires root and [--expired] transaction-id", file=sys.stderr); raise SystemExit(64)
try:
    if len(sys.argv) == 3 and sys.argv[1] == "--expired":
        result = Controller().expire(sys.argv[2])
    elif len(sys.argv) == 2:
        result = Controller().rollback(sys.argv[1], "health deadline expired")
    else:
        raise TransactionError("unknown rollback mode")
    print(json.dumps(result, sort_keys=True))
except TransactionError as exc:
    print(str(exc), file=sys.stderr); raise SystemExit(1)
