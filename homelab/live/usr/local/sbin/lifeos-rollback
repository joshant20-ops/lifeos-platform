#!/usr/bin/env python3
import json, os, sys
sys.path.insert(0, "/usr/local/lib")
from lifeos_transaction import Controller, TransactionError
if os.geteuid() != 0 or len(sys.argv) != 2:
    print("lifeos-rollback requires root and one transaction id", file=sys.stderr); raise SystemExit(64)
try:
    print(json.dumps(Controller().rollback(sys.argv[1], "health deadline expired"), sort_keys=True))
except TransactionError as exc:
    print(str(exc), file=sys.stderr); raise SystemExit(1)
