[Unit]
Description=Record LifeOS Power Down assurance evidence
After=lifeos-powerdown-assurance-active.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/lifeos-powerdown-evidence-recorder
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/lifeos-watch/octopus-powerdown-assurance
