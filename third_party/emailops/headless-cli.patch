+/// Provider read-back proof for consumers that close an external workflow.
+/// A successful move request or a local spam flag alone is insufficient.
+pub async fn file_in_spam_verified(db: &Database, email: &Email, provider: &dyn EmailProvider) -> Result<bool> {
+    let expected = email
+        .message_id
+        .as_deref()
+        .filter(|s| !s.trim().is_empty())
+        .ok_or_else(|| AppError::InvalidInput("stable Message-ID is required for verified filing".into()))?;
+    let location = if email.mailbox == "spam" {
+        crate::sync::provider::MessageLocation {
+            id: email.id.clone(),
+            mailbox: "spam".into(),
+        }
+    } else {
+        match provider.move_to_spam(&email.id, Some(expected)).await {
+            Ok(location) => location,
+            Err(AppError::NoSpamFolder) => return Ok(false),
+            Err(e) => return Err(e),
+        }
+    };
+    let (remote, _, _) = provider.get_message(&location.id).await?;
+    if !spam_readback_matches(expected, &remote) {
+        return Err(AppError::SyncError("provider junk filing could not be verified".into()));
+    }
+    refile_moved_row(db, &email.id, &location.id, "spam")?;
+    Ok(true)
+}
+
+fn spam_readback_matches(expected: &str, remote: &Email) -> bool {
+    remote.mailbox == "spam" && remote.message_id.as_deref() == Some(expected)
+}
