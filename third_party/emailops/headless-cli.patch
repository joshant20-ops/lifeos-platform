+fn read_password_file(path: &std::path::Path) -> Result<String> {
+    use std::io::Read;
+    let metadata =
+        std::fs::symlink_metadata(path).map_err(|_| AppError::InvalidInput("password file unavailable".into()))?;
+    if !metadata.is_file() {
+        return Err(AppError::InvalidInput("password file must be a regular file".into()));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o077 != 0 {
+            return Err(AppError::InvalidInput("password file must be private".into()));
+        }
+    }
+    let mut secret = String::new();
+    std::fs::File::open(path)
+        .map_err(|_| AppError::InvalidInput("password file unavailable".into()))?
+        .take(4097)
+        .read_to_string(&mut secret)
+        .map_err(|_| AppError::InvalidInput("password file unreadable".into()))?;
+    let secret = secret.trim_end_matches(['\r', '\n']);
+    if secret.is_empty() || secret.len() > 4096 {
+        return Err(AppError::InvalidInput("password file has invalid length".into()));
+    }
+    Ok(secret.to_string())
+}
