+/// Select answer content without treating private reasoning as structured output.
+fn completed_text(content: String, thinking: String, truncated: bool, structured: bool) -> Result<(String, bool)> {
+    if structured && truncated {
+        return Err(AppError::AiError("structured completion reached token limit".into()));
+    }
+    if structured && content.trim().is_empty() {
+        return Err(AppError::AiError("structured completion answer empty".into()));
+    }
+    if content.is_empty() && !thinking.is_empty() {
+        Ok((thinking, truncated))
+    } else {
+        Ok((content, truncated))
+    }
+}
