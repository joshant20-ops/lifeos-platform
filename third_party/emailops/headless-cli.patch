+//! Headless previews and explicit user-confirmed Junk, over the shared services.
+use crate::models::error::{AppError, Result};
+use crate::services::{ai::AiService, emails, junk, ownership, tasks};
+
+use super::{output, session::CliSession};
+
+pub async fn analyze(session: &CliSession, id: &str) -> Result<()> {
+    let account = session.require_account()?;
+    let email = ownership::email_in_account(&session.db, &account, id)?;
+    let ai = AiService::new(session.db.clone())?;
+    let extracted = tasks::extractor::extract_for_eval(&session.db, &ai, &email).await?;
+    output::emit_ok(serde_json::json!({
+        "schema": "emailops_analysis_v1",
+        "source": {
+            "id": email.id, "accountId": email.account_id,
+            "threadId": email.thread_id, "messageId": email.message_id,
+            "references": email.references, "mailbox": email.mailbox,
+        },
+        "extraction": extracted,
+    }))
+}
+
+pub async fn report_junk(session: &CliSession, id: &str, confirm: bool) -> Result<()> {
+    if !confirm {
+        return Err(AppError::InvalidInput("explicit --confirm is required".into()));
+    }
+    let account_id = session.require_account()?;
+    let email = ownership::email_in_account(&session.db, &account_id, id)?;
+    let account = session
+        .db
+        .get_account(&account_id)?
+        .ok_or_else(|| AppError::NotFound("account not found".into()))?;
+    let provider = emails::build_provider(&account, None).await?;
+    junk::set_feedback(&session.db, &account_id, id, true).await?;
+    let filed = emails::file_in_spam_verified(&session.db, &email, provider.as_ref()).await?;
+    output::emit_ok(serde_json::json!({"filed": filed, "verified": filed}))
+}
