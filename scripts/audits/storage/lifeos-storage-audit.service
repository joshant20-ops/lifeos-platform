[Unit]
Description=Fixed read-only LifeOS storage audit

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/lifeos-storage-audit/worker.py --collect
User=root
UMask=0077
StateDirectory=lifeos-storage-audit
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/lifeos-storage-audit
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
Nice=19
IOSchedulingClass=idle
IOWeight=10
CPUQuota=20%
MemoryMax=384M
TimeoutStartSec=110
TimeoutStopSec=5
KillMode=control-group
