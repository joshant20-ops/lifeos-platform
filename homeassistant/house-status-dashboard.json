{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.dashboard_house_status",
  "data": {
    "config": {
      "title": "House Status",
      "views": [
        {
          "title": "Domestic Energy Consumption",
          "path": "domestic-energy-consumption",
          "icon": "mdi:home-lightning-bolt",
          "type": "masonry",
          "cards": [
            {
              "type": "custom:lifeos-house-status",
              "mode": "domestic"
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": false
              },
              "graph_span": "48h",
              "span": {
                "start": "day"
              },
              "apex_config": {
                "chart": {
                  "height": 360
                },
                "legend": {
                  "show": true,
                  "position": "bottom"
                }
              },
              "yaxis": [
                {
                  "id": "price",
                  "decimals": 0
                },
                {
                  "id": "cost",
                  "opposite": true,
                  "decimals": 2
                }
              ],
              "series": [
                {
                  "entity": "sensor.lifeos_energy_tariff_horizon",
                  "name": "Electricity price",
                  "type": "line",
                  "unit": "p/kWh",
                  "yaxis_id": "price",
                  "stroke_width": 2,
                  "extend_to": false,
                  "data_generator": "return (entity.attributes.slots || []).filter(x => x.import_p_per_kwh !== null).map(x => [new Date(x.local_from).getTime(), Number(x.import_p_per_kwh)]);"
                },
                {
                  "entity": "sensor.lifeos_energy_report",
                  "name": "Electricity used cost",
                  "type": "line",
                  "unit": "£",
                  "yaxis_id": "cost",
                  "extend_to": false,
                  "data_generator": "return (entity.attributes.intervals || []).filter(x => x.domestic_import_cost_gbp !== null).map(x => [new Date(x.valid_from).getTime(), Number(x.domestic_import_cost_gbp)]);"
                },
                {
                  "entity": "sensor.lifeos_energy_report",
                  "name": "Export earnings",
                  "type": "line",
                  "unit": "£",
                  "yaxis_id": "cost",
                  "extend_to": false,
                  "data_generator": "return (entity.attributes.intervals || []).filter(x => x.export_earnings_gbp !== null).map(x => [new Date(x.valid_from).getTime(), -Number(x.export_earnings_gbp)]);"
                }
              ]
            }
          ]
        },
        {
          "title": "Full Energy Flow",
          "path": "full-energy-flow",
          "icon": "mdi:transmission-tower",
          "type": "masonry",
          "cards": [
            {
              "type": "custom:lifeos-house-status",
              "mode": "flow"
            },
            {
              "type": "custom:apexcharts-card",
              "header": {
                "show": false
              },
              "graph_span": "24h",
              "span": {
                "start": "day"
              },
              "apex_config": {
                "chart": {
                  "height": 360,
                  "stacked": true
                },
                "legend": {
                  "show": true,
                  "position": "bottom"
                }
              },
              "yaxis": [
                {
                  "id": "power",
                  "decimals": 2
                },
                {
                  "id": "price",
                  "opposite": true,
                  "decimals": 1
                },
                {
                  "id": "soc",
                  "opposite": true,
                  "min": 0,
                  "max": 100,
                  "show": false
                }
              ],
              "series": [
                {
                  "entity": "sensor.lifeos_house_demand_power",
                  "name": "House usage",
                  "type": "column",
                  "yaxis_id": "power",
                  "group_by": {
                    "func": "avg",
                    "duration": "30min"
                  }
                },
                {
                  "entity": "sensor.lifeos_battery_charge_power",
                  "name": "Battery charging",
                  "type": "column",
                  "yaxis_id": "power",
                  "group_by": {
                    "func": "avg",
                    "duration": "30min"
                  }
                },
                {
                  "entity": "sensor.lifeos_grid_export_power",
                  "name": "Grid export",
                  "type": "column",
                  "yaxis_id": "power",
                  "transform": "return -Math.abs(x);",
                  "group_by": {
                    "func": "avg",
                    "duration": "30min"
                  }
                },
                {
                  "entity": "sensor.lifeos_energy_tariff_horizon",
                  "name": "Electricity price",
                  "type": "line",
                  "unit": "p/kWh",
                  "yaxis_id": "price",
                  "stroke_width": 2,
                  "extend_to": false,
                  "data_generator": "return (entity.attributes.slots || []).filter(x => x.import_p_per_kwh !== null).map(x => [new Date(x.local_from).getTime(), Number(x.import_p_per_kwh)]);"
                },
                {
                  "entity": "sensor.lifeos_energy_battery_soc",
                  "name": "Battery SOC",
                  "type": "line",
                  "unit": "%",
                  "yaxis_id": "soc",
                  "stroke_width": 2
                }
              ]
            }
          ]
        },
        {
          "title": "Home Status",
          "path": "home-status",
          "icon": "mdi:home-eye",
          "type": "masonry",
          "cards": [
            {
              "type": "custom:lifeos-house-status",
              "mode": "home"
            }
          ]
        },
        {
          "title": "Doorbell",
          "path": "doorbell",
          "icon": "mdi:doorbell-video",
          "cards": [
            {
              "type": "picture-entity",
              "entity": "camera.front_door_live_view",
              "name": "Front Door",
              "camera_view": "live",
              "show_name": true,
              "show_state": true,
              "tap_action": {
                "action": "none"
              },
              "hold_action": {
                "action": "none"
              }
            },
            {
              "type": "grid",
              "columns": 2,
              "square": false,
              "cards": [
                {
                  "type": "tile",
                  "entity": "event.front_door_motion",
                  "name": "Last motion",
                  "icon": "mdi:motion-sensor"
                },
                {
                  "type": "tile",
                  "entity": "event.front_door_ding",
                  "name": "Last doorbell press",
                  "icon": "mdi:doorbell"
                }
              ]
            },
            {
              "type": "markdown",
              "content": "### Current doorbell · Ring Front Door\nMotion and bell events are enrolled now. **Motion = 30 seconds** and **bell press = 90 seconds** for the presentation window. Repeated motion extends the active window.\n\nAutomatic navigation remains dormant until a supported shared-display control mechanism is proven; bedroom/private displays are not enrolled by default. The entity mapping is isolated so a future replacement doorbell can be swapped without redesigning this view."
            }
          ]
        }
      ]
    }
  }
}
