# Variable names only. Put real values in an external mode-0600 runtime file.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_MODEL=
LIFEOS_GOVERNOR_STATE_DIR=

# GitHub issue intake. Use a least-privilege token that can read the private repo.
LIFEOS_GITHUB_TOKEN=
LIFEOS_GITHUB_REPOSITORY=joshant20-ops/lifeos-platform
LIFEOS_GITHUB_BASE_BRANCH=main
LIFEOS_GITHUB_READY_LABEL=lifeos-engineer-ready
LIFEOS_GITHUB_READY_MARKER=<!-- lifeos-engineer:ready -->
LIFEOS_GITHUB_ALLOWED_AUTHORS=joshant20-ops

# Engineer checkout used only for isolated git worktrees; never point this at Pi production.
LIFEOS_ENGINEER_REPO=/home/joshan/workspace/lifeos-platform
